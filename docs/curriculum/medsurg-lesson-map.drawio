" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EADCCF;strokeColor=#6B5243;fontColor=#3F2E24;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=0;arcSize=18;" vertex="1" parent="1"><mxGeometry x="1400" y="226" width="340" height="60" as="geometry"/></mxCell><mxCell id="933" value="every clinical lesson passes the cueory review pipeline before it is published. higher-risk lessons (first actions, dosing, emergencies) wait for a qualified reviewer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EADCCF;strokeColor=#6B5243;fontColor=#3F2E24;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=0;arcSize=18;" vertex="1" parent="1"><mxGeometry x="1400" y="296" width="340" height="60" as="geometry"/></mxCell>
