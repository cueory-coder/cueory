// Cloudflare Workers settings (DECISIONS.md, D-29).
// The site is plain static files from `npm run build` (the dist folder); no server code runs.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cueory",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./dist",
    // Unknown addresses get our 404 page.
    "not_found_handling": "404-page",
    // /privacy, not /privacy/ (matches trailingSlash: 'never' in astro.config.mjs).
    "html_handling": "drop-trailing-slash"
  }
}
