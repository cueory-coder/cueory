---
/**
 * Two ways in, using real Cueory destinations and original, built-in visuals: one large tile and one small, side by
 * side from tablet width, stacked on phones. Daily games has its own section just above, and break ideas stay off the
 * home page until Christian approves them.
 */
import ModeIllustration from './ModeIllustration.astro';
---

<section id="study-features" class="scene scene-tint scroll-mt-section py-section" aria-labelledby="features-heading">
  <div class="mx-auto max-w-page px-gutter" data-reveal-section>
    <div class="mx-auto max-w-prose text-center">
      <h2 id="features-heading" class="display text-title sm:text-title-lg">made for the way you study</h2>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      <a href="/learn/study-skills/cards" data-testid="feature-cards" class="veil group flex min-w-0 flex-col p-6 text-ink no-underline md:p-8 lg:col-span-2">
        <div class="flex flex-col gap-2">
          <p class="text-sm font-bold text-ink-soft">study</p>
          <h3 class="text-2xl font-medium">practice with cards</h3>
        </div>
        <div class="mode-art mx-auto mt-6 w-full max-w-xs" aria-hidden="true">
          <ModeIllustration mode="cards" />
        </div>
        <span class="mt-auto pt-6 font-medium underline underline-offset-4">open the cards</span>
      </a>

      <a href="/learn/study-skills" data-testid="feature-offline" class="veil group flex min-w-0 flex-col p-6 text-ink no-underline md:p-8">
        <p class="text-sm font-bold text-ink-soft">continue</p>
        <h3 class="mt-3 text-xl font-medium">opened lessons can work offline</h3>
        <p class="mt-2 text-ink-soft">after you open a lesson while online, your browser may keep a copy to read without a connection.</p>
        <div class="mt-5 w-full max-w-prose rounded-lg border border-line bg-surface p-4" aria-hidden="true">
          <span class="block text-sm font-medium">lesson</span>
          <span class="mt-3 block h-2 w-full rounded-pill bg-line"></span>
          <span class="mt-2 block h-2 w-3/4 rounded-pill bg-line"></span>
        </div>
        <span class="mt-auto pt-6 font-medium underline underline-offset-4">open a lesson</span>
      </a>
    </div>
  </div>
</section>
