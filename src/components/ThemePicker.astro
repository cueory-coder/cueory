---
// Light / Dark / Follow device switch (brand spec section 9). Hidden until its script runs, so visitors without
// JavaScript simply follow their device setting.
//
// The three radio inputs live inside a .segmented pill. They are still real <input type="radio"> elements, so the
// control works without JavaScript and is fully keyboard-navigable. .segmented styles come from global.css (Task 77);
// the scoped <style> below provides equivalent layout until that merge lands.
const options = [
  {
    value: 'light',
    label: 'light',
    icon: `<svg viewBox="0 0 24 24" class="size-4" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="4" fill="currentColor"/>
      <line x1="12" y1="2" x2="12" y2="5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="12" y1="19" x2="12" y2="22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="4.22" y1="4.22" x2="6.34" y2="6.34" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="17.66" y1="17.66" x2="19.78" y2="19.78" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="2" y1="12" x2="5" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="19" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="4.22" y1="19.78" x2="6.34" y2="17.66" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="17.66" y1="6.34" x2="19.78" y2="4.22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>`,
  },
  {
    value: 'dark',
    label: 'dark',
    icon: `<svg viewBox="0 0 24 24" class="size-4" aria-hidden="true" focusable="false">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor"/>
    </svg>`,
  },
  {
    value: 'device',
    label: 'auto',
    icon: `<svg viewBox="0 0 24 24" class="size-4" aria-hidden="true" focusable="false">
      <rect x="5" y="2" width="14" height="20" rx="2" stroke="currentColor" stroke-width="2" fill="none"/>
      <circle cx="12" cy="17" r="1" fill="currentColor"/>
    </svg>`,
  },
];
---

<fieldset data-theme-picker hidden>
  <legend class="sr-only">theme</legend>
  <div class="segmented">
    {
      options.map((option) => (
        <label class="segmented-option">
          <input type="radio" name="theme" value={option.value} class="sr-only" />
          <Fragment set:html={option.icon} />
          <span>{option.label}</span>
        </label>
      ))
    }
  </div>
</fieldset>

<style>
  /* Scoped segmented-pill layout — mirrors the Task 77 global classes until they land in staging. */
  fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  .segmented {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-control);
    border-radius: 9999px;
    padding: 2px;
    background: var(--color-surface);
  }

  .segmented-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    min-height: 2.75rem;
    user-select: none;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .segmented-option:has(:checked) {
    background-color: var(--color-ink);
    color: var(--color-on-button);
  }

  .segmented-option:focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: 9999px;
  }

  @media (prefers-reduced-motion: reduce) {
    .segmented-option {
      transition: none;
    }
  }
</style>

<script>
  import { applyChoice, browserStorage, isThemeChoice, readChoice, saveChoice } from '../scripts/theme';

  const picker = document.querySelector<HTMLFieldSetElement>('[data-theme-picker]');
  const root = document.documentElement;
  const storage = browserStorage();

  // Phones tint the browser bar with theme-color. Match an explicit pick; restore the device-based values otherwise.
  const themeColors = [...document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')].map((meta) => ({
    meta,
    original: meta.content,
  }));

  function syncThemeColor(choice: string) {
    const page = getComputedStyle(root).getPropertyValue('--color-page').trim();
    for (const { meta, original } of themeColors) meta.content = choice === 'device' || !page ? original : page;
  }

  if (picker) {
    const current = readChoice(storage);
    applyChoice(root, current);
    syncThemeColor(current);

    const selected = picker.querySelector<HTMLInputElement>(`input[value="${current}"]`);
    if (selected) selected.checked = true;

    picker.addEventListener('change', (event) => {
      const value = (event.target as HTMLInputElement).value;
      if (!isThemeChoice(value)) return;
      applyChoice(root, value);
      saveChoice(storage, value);
      syncThemeColor(value);
    });

    picker.hidden = false;
  }
</script>
