---
/**
 * "ways to study" on the home page (D-50, D-60), drawn as Christian's vials (Task 109, the prototype he approved on
 * 2026-11-01: docs/screenshots/approved-2026-11-01/vial-carousel-*). A small "ways to study" heading and the serif
 * line, then the eleven vials standing in a shallow arc on a soft pedestal, with the arrows and the dots under it. No
 * caption repeats the vial's name (Christian, 2026-11-02: no description that only restates its label).
 *
 * Without JavaScript it still works: the vials are a row that scrolls sideways and snaps each vial to the middle, each
 * with its link (or "coming soon") under it. The script turns the row into the ring: the vial in front is the largest
 * and brightest, and the others step back on both sides, smaller, further back, a little higher and dimmer. Next
 * after the last vial is the first again, and previous before the first is the last. The arrows, the arrow keys, a
 * swipe or a tap on a side vial turn it; a tap or Enter on the vial in front opens its preview. A gentle auto-advance
 * stops for good once the visitor uses it, pauses while a mouse rests on the vials or keyboard focus is inside, and
 * never runs with reduced motion, which also drops the glide. The pause button stops the auto-advance (WCAG 2.2.2).
 * Screen readers hear only the vial where the ring comes to rest.
 *
 * The preview (D-51): the same bottle grows from its place in the ring toward the middle of the screen while the page
 * darkens, then the cream panel opens around it with the method's name and its ⓘ (the four feature rows, shown only
 * when asked: src/components/InfoTip.astro), "start …" (or "coming soon") and the free-account link: two columns on wider screens, stacked on phones. It is a native modal
 * <dialog>. Close it with the X, Escape, a tap on the darkened page or a swipe down; it closes back into its vial and
 * focus returns there. Previous and next inside move through the methods in the ring's order, and the ring behind
 * follows. With a mouse, the vial in front lifts a little and its glass brightens under the pointer or keyboard focus.
 */
import { studyModes, type StudyFeatureIcon } from '../config/modes';
import { accountHref } from '../config/site';
import InfoTip from './InfoTip.astro';
import ModeVial from './ModeVial.astro';

const count = studyModes.length;
const first = studyModes[0]!;

/** The feature rows' outline icons (in the preview's ⓘ): plain strokes in the text color, 24 × 24. Decorative. */
const icons: Record<StudyFeatureIcon, string> = {
  play: 'M8.5 6.5v11l9-5.5z',
  tap: 'M9 11V5.5a1.5 1.5 0 013 0V11m0-1.5a1.5 1.5 0 013 0V12m0-1a1.5 1.5 0 013 0v3.5a5.5 5.5 0 01-5.5 5.5h-1A5.5 5.5 0 016 16l-1.5-3a1.5 1.5 0 012.6-1.5L9 14',
  eye: 'M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12zM12 15a3 3 0 100-6 3 3 0 000 6z',
  text: 'M5 6h14M5 10h14M5 14h10M5 18h7',
  flip: 'M7 4.5h10a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5H7A1.5 1.5 0 015.5 18V6A1.5 1.5 0 017 4.5zM9 12h6',
  sort: 'M4 6h7M4 12h7M4 18h7M15 8l3-3 3 3M18 5v14',
  repeat: 'M5 12a7 7 0 0112-4.9L19 9M19 4.5V9h-4.5M19 12a7 7 0 01-12 4.9L5 15m0 4.5V15h4.5',
  spark: 'M12 3.5l1.9 5.1 5.1 1.9-5.1 1.9L12 17.5l-1.9-5.1-5.1-1.9 5.1-1.9z',
  steps: 'M4 19h5v-5h5V9h5V4',
  type: 'M4 7.5h16v9H4zM7 12h.01M10 12h.01M13 12h4',
  check: 'M4.5 12.5l4.5 4.5 10-10',
  link: 'M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1',
  clock: 'M12 20.5a8.5 8.5 0 100-17 8.5 8.5 0 000 17zM12 7.5V12l3 2',
  group: 'M4 5h6v6H4zM14 5h6v6h-6zM4 15h6v4H4zM14 15h6v4h-6z',
  list: 'M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01',
  calendar: 'M5 6.5h14v13H5zM5 10.5h14M9 4v4M15 4v4',
  target: 'M12 20.5a8.5 8.5 0 100-17 8.5 8.5 0 000 17zM12 16a4 4 0 100-8 4 4 0 000 8zM12 12h.01',
};
---

<section
  id="ways-to-study"
  class="modes scene scene-tint py-section scroll-mt-section"
  role="region"
  aria-labelledby="modes-heading"
  aria-roledescription="carousel"
  data-modes
>
  <!-- The heading, the vials and their buttons fade in together the first time they come into view (D-62). -->
  <div data-reveal-section>
  <div class="mx-auto max-w-page px-gutter text-center">
    <h2 id="modes-heading" class="modes-kicker">ways to study</h2>
    <p class="display mt-2 text-title sm:text-title-lg">one lesson, eleven ways in</p>
  </div>

  <div class="vial-stage mt-8">
    <div class="vial-scenery" aria-hidden="true">
      <span class="vial-glow"></span>
      <span class="vial-light"></span>
      <span class="vial-pedestal"></span>
    </div>

    <div
      id="modes-track"
      class="modes-track"
      role="group"
      tabindex="0"
      aria-label="study mode cards"
      data-modes-track
    >
      {
        studyModes.map((mode, index) => (
          <div
            id={`mode-${mode.id}`}
            class="mode-card"
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${count}`}
            data-mode-card
            data-name={mode.name}
            data-href={mode.link?.href}
          >
            <button
              type="button"
              class="mode-open"
              aria-label={`preview ${mode.name}`}
              aria-describedby={`mode-${mode.id}-summary`}
              aria-haspopup="dialog"
              aria-controls="mode-preview"
              hidden
              data-mode-open
            />
            <ModeVial mode={mode} summaryId={`mode-${mode.id}-summary`} />
            {mode.link ? (
              <a href={mode.link.href} class="mode-card-link inline-flex min-h-11 items-center justify-center px-3">
                {mode.link.label}
              </a>
            ) : (
              <p class="mode-card-link text-sm text-ink-soft">coming soon</p>
            )}
          </div>
        ))
      }
    </div>

    <div class="invisible" data-modes-controls>
      <div class="modes-controls">
        <button type="button" class="corner-button vial-arrow vial-arrow-prev" aria-label="previous study mode" data-modes-prev>
          <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
            <path d="M14.5 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </button>
        <div class="modes-dots" aria-hidden="true">
          {studyModes.map((_, index) => <span class="modes-dot" data-modes-dot data-on={index === 0 ? '' : undefined} />)}
        </div>
        <button type="button" class="corner-button vial-arrow vial-arrow-next" aria-label="next study mode" data-modes-next>
          <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
            <path d="M9.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <div class="mt-3 flex justify-center">
        <button type="button" class="corner-button" aria-label="pause the slideshow" data-modes-pause>
          <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false" data-icon-pause>
            <path d="M9 7v10M15 7v10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          <svg viewBox="0 0 24 24" class="hidden size-6" aria-hidden="true" focusable="false" data-icon-play>
            <path d="M9 6.5l8.5 5.5L9 17.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
  </div>

  <p class="sr-only" aria-live="off" aria-atomic="true" data-modes-live></p>

  <dialog id="mode-preview" class="mode-preview" aria-labelledby="mode-preview-title" data-mode-preview>
    <div class="mode-preview-scrim" data-mode-preview-scrim></div>
    <div class="mode-preview-panel" data-mode-preview-panel>
      <span class="mode-preview-surface" aria-hidden="true" data-mode-preview-surface></span>
      <div class="mode-preview-close" data-mode-preview-fade>
        <button type="button" class="corner-button" aria-label="close preview" data-mode-preview-close>
          <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <!-- The same bottle as in the ring, copied in when the preview opens. Decoration: the words beside it say it. -->
      <div class="mode-preview-bottle" aria-hidden="true" data-mode-preview-vial></div>
      <div class="mode-preview-details" data-mode-preview-fade>
        <span class="mode-preview-rule" aria-hidden="true"></span>
        <div class="mt-3 flex flex-wrap items-center gap-x-1">
          <h2 id="mode-preview-title" class="display text-title" data-mode-preview-title></h2>
          <InfoTip id="mode-preview-info" label={first.name}>
            {
              studyModes.map((mode) => (
                <ul class="mode-features" hidden data-mode-preview-features={mode.id}>
                  {mode.features.map((feature) => (
                    <li>
                      <svg viewBox="0 0 24 24" class="mode-feature-icon" aria-hidden="true" focusable="false">
                        <path d={icons[feature.icon]} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      <span>{feature.text}</span>
                    </li>
                  ))}
                </ul>
              ))
            }
          </InfoTip>
        </div>
        <div class="mt-7 flex flex-col items-start gap-4">
          <a href="/" class="glass-button" data-mode-preview-try>
            <span data-mode-preview-try-label>start</span><span aria-hidden="true"> →</span>
          </a>
          <p class="mode-soon" data-mode-preview-soon>coming soon</p>
          <a href={accountHref} class="text-sm text-ink-soft hover:text-ink">create your free account</a>
        </div>
        <div class="mt-7 flex gap-3">
          <button type="button" class="corner-button" aria-label="previous study mode" data-mode-preview-prev>
            <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
              <path d="M14.5 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </button>
          <button type="button" class="corner-button" aria-label="next study mode" data-mode-preview-next>
            <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
              <path d="M9.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
        <p class="sr-only" aria-live="polite" aria-atomic="true" data-mode-preview-live></p>
      </div>
    </div>
  </dialog>
</section>

<script>
  import {
    AUTO_ADVANCE_MS,
    PREVIEW_EASING,
    PREVIEW_MS,
    PREVIEW_SPLIT,
    REST_MS,
    STEP_MS,
    canAutoAdvance,
    canEnhanceCarousel,
    clipAround,
    flipFrom,
    glides,
    isSwipeDown,
    keyTarget,
    ringOffset,
    ringPlace,
    slideAnnouncement,
    swipeTurn,
    wrap,
  } from '../scripts/carousel';
  import { relabelInfoTip } from '../scripts/infotip';
  import { isCloseKey, wrapFocus } from '../scripts/menu';

  const root = document.querySelector<HTMLElement>('[data-modes]');
  const track = root?.querySelector<HTMLElement>('[data-modes-track]');
  const previewDialog = root?.querySelector<HTMLDialogElement>('[data-mode-preview]');
  const previewBottle = previewDialog?.querySelector<HTMLElement>('[data-mode-preview-vial]');
  const previewParts = [
    previewDialog?.querySelector<HTMLElement>('[data-mode-preview-panel]'),
    previewDialog?.querySelector<HTMLElement>('[data-mode-preview-scrim]'),
    previewBottle,
    previewDialog?.querySelector<HTMLElement>('[data-mode-preview-surface]'),
    ...(previewDialog?.querySelectorAll<HTMLElement>('[data-mode-preview-fade]') ?? []),
  ];

  // Keep the native scroll-and-link version unless the entire modal preview can work.
  // In particular, never hide its links when HTMLDialogElement.showModal is missing.
  if (root && track && canEnhanceCarousel({
    nativeDialog: typeof HTMLDialogElement === 'function' && previewDialog instanceof HTMLDialogElement,
    dialog: previewDialog,
    animationTargets: previewParts,
    matchMedia: window.matchMedia,
    intersectionObserver: typeof IntersectionObserver === 'function' ? IntersectionObserver : undefined,
    replaceChildren: previewBottle?.replaceChildren,
  })) {
    const cards = [...track.querySelectorAll<HTMLElement>('[data-mode-card]')];
    const openButtons = cards.map((card) => card.querySelector<HTMLButtonElement>('[data-mode-open]'));
    const live = root.querySelector<HTMLElement>('[data-modes-live]');
    const pauseButton = root.querySelector<HTMLButtonElement>('[data-modes-pause]');
    const dots = [...root.querySelectorAll<HTMLElement>('[data-modes-dot]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const state = {
      reducedMotion: reducedMotion.matches,
      paused: false,
      tookOver: false,
      hovering: false,
      focusInside: false,
      onScreen: false,
    };
    /** The vial in front. */
    let active = 0;
    /** The card last written to the live region (none yet). */
    let announced = -1;
    /** While the preview is open it speaks for itself, so the merry-go-round behind it stays quiet. */
    let quiet = false;
    /** Opens the preview of the card in the middle, once the preview is ready (below). */
    let preview: ((index: number) => void) | undefined;
    /** Where each card was last put: how many cards from the middle (none yet). */
    const offsets = cards.map(() => Number.NaN);

    /**
     * Puts every vial in its place on the arc around the one in front. The styles draw each place from the numbers set
     * here (global.css); a vial going round the back, or the first placing, switches at once instead of gliding.
     */
    const place = () => {
      cards.forEach((card, index) => {
        const offset = ringOffset(index, active, cards.length);
        const spot = ringPlace(offset);
        const before = offsets[index]!;
        offsets[index] = offset;
        card.toggleAttribute('data-jump', Number.isNaN(before) || !glides(before, offset));
        card.dataset.offset = String(offset);
        card.style.setProperty('--ring-shift', String(spot.shift));
        card.style.setProperty('--ring-rise', String(spot.rise));
        card.style.setProperty('--ring-depth', String(spot.depth));
        card.style.setProperty('--ring-scale', String(spot.scale));
        card.style.setProperty('--ring-bright', String(spot.bright));
        card.style.setProperty('--ring-saturate', String(spot.saturate));
        card.style.setProperty('--ring-layer', String(spot.layer));
        card.toggleAttribute('data-far', !spot.shown);
        card.toggleAttribute('data-active', offset === 0);
        // Only the vial in front is in the Tab order. A side vial is one tap, or one arrow key, away.
        const button = openButtons[index];
        if (button) {
          button.tabIndex = offset === 0 ? 0 : -1;
          button.setAttribute('aria-label', `${offset === 0 ? 'preview' : 'show'} ${card.dataset.name ?? ''}`);
          if (offset === 0) button.setAttribute('aria-haspopup', 'dialog');
          else button.removeAttribute('aria-haspopup');
        }
        // The ring's own links wait under the vials for visitors without JavaScript; the preview has "start …".
        for (const link of card.querySelectorAll('a')) link.tabIndex = -1;
      });
      dots.forEach((dot, index) => dot.toggleAttribute('data-on', index === active));
    };

    /**
     * Only the card where the merry-go-round comes to rest is announced: a run of quick presses or swipes reads out
     * where it stops, never every card it passes. The cards themselves move at once.
     */
    let rest = 0;
    const announceAtRest = () => {
      window.clearTimeout(rest);
      rest = window.setTimeout(() => {
        if (!live || announced === active) return;
        announced = active;
        if (quiet) return;
        live.textContent = slideAnnouncement(cards[active]!.dataset.name ?? '', active, cards.length);
      }, REST_MS);
    };

    const goTo = (index: number) => {
      const next = wrap(index, cards.length);
      if (next === active) return;
      // Keyboard focus on the card in the middle moves with it to the new card in the middle.
      const focusInCard = cards[active]!.contains(document.activeElement);
      active = next;
      place();
      announceAtRest();
      if (focusInCard) openButtons[active]?.focus({ preventScroll: true });
    };

    /** Anything the visitor does on the carousel puts them in charge: auto-advance stops and changes are announced. */
    const takeOver = () => {
      state.tookOver = true;
      live?.setAttribute('aria-live', 'polite');
    };

    root.querySelector('[data-modes-prev]')?.addEventListener('click', () => {
      takeOver();
      goTo(active - 1);
    });
    root.querySelector('[data-modes-next]')?.addEventListener('click', () => {
      takeOver();
      goTo(active + 1);
    });

    track.addEventListener('keydown', (event) => {
      const target = keyTarget(event.key, active, cards.length);
      if (target === undefined) return;
      event.preventDefault();
      takeOver();
      goTo(target);
    });

    // A tap on a side vial brings it to the front; a tap (or Enter) on the vial in front opens its preview.
    let swiped = false;
    openButtons.forEach((button, index) => {
      button?.addEventListener('click', () => {
        if (swiped) return;
        if (index === active) {
          preview?.(index);
          return;
        }
        takeOver();
        goTo(index);
      });
      if (button) button.hidden = false;
    });

    // A finger swiping sideways across the cards turns the merry-go-round one card. Up and down still scrolls the page.
    let swipeStart: { x: number; y: number; id: number } | undefined;
    track.addEventListener(
      'pointerdown',
      (event) => {
        swiped = false;
        swipeStart = event.pointerType === 'mouse' ? undefined : { x: event.clientX, y: event.clientY, id: event.pointerId };
      },
      { passive: true },
    );
    track.addEventListener('pointerup', (event) => {
      const start = swipeStart;
      swipeStart = undefined;
      if (!start || start.id !== event.pointerId) return;
      const turn = swipeTurn(event.clientX - start.x, event.clientY - start.y);
      if (!turn) return;
      // The tap that some browsers report at the end of a swipe is not a tap on a card.
      swiped = true;
      window.setTimeout(() => {
        swiped = false;
      }, REST_MS);
      takeOver();
      goTo(active + turn);
    });
    track.addEventListener('pointercancel', () => {
      swipeStart = undefined;
    });

    // The merry-go-round never scrolls: if anything scrolls its box to show a side card, that is undone at once.
    track.addEventListener(
      'scroll',
      () => {
        if (root.hasAttribute('data-ring') && (track.scrollLeft !== 0 || track.scrollTop !== 0)) track.scrollTo(0, 0);
      },
      { passive: true },
    );

    // A sideways swipe on a trackpad turns it one card per gesture; scrolling the page past it is left alone.
    let wheelTotal = 0;
    let wheelTurned = false;
    let wheelQuiet = 0;
    track.addEventListener(
      'wheel',
      (event) => {
        if (Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
        event.preventDefault();
        wheelTotal += event.deltaX;
        window.clearTimeout(wheelQuiet);
        wheelQuiet = window.setTimeout(() => {
          wheelTotal = 0;
          wheelTurned = false;
        }, 200);
        if (wheelTurned || Math.abs(wheelTotal) < 60) return;
        wheelTurned = true;
        takeOver();
        goTo(active + (wheelTotal > 0 ? 1 : -1));
      },
      { passive: false },
    );

    // A mouse resting on the cards or their buttons pauses the auto-advance. The words around them don't: the section
    // is taller than many windows, so pausing for the whole of it would stop the auto-advance for good on a computer.
    const hovered = new Set<HTMLElement>();
    for (const area of [track, root.querySelector<HTMLElement>('[data-modes-controls]')]) {
      area?.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') hovered.add(area);
        state.hovering = hovered.size > 0;
      });
      area?.addEventListener('pointerleave', () => {
        hovered.delete(area);
        state.hovering = hovered.size > 0;
      });
    }
    root.addEventListener('focusin', () => {
      state.focusInside = true;
    });
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) state.focusInside = false;
    });

    /** The pause button stops the auto-advance, the only thing here that moves by itself. */
    const showPaused = () => {
      root.toggleAttribute('data-paused', state.paused);
      pauseButton?.setAttribute('aria-label', `${state.paused ? 'play' : 'pause'} the slideshow`);
      pauseButton?.querySelector('[data-icon-pause]')?.classList.toggle('hidden', state.paused);
      pauseButton?.querySelector('[data-icon-play]')?.classList.toggle('hidden', !state.paused);
      live?.setAttribute('aria-live', state.paused || state.tookOver ? 'polite' : 'off');
    };
    pauseButton?.addEventListener('click', () => {
      state.paused = !state.paused;
      // Playing again lets the auto-advance run again, even after the visitor took over.
      if (!state.paused) state.tookOver = false;
      showPaused();
    });

    const applyMotion = () => {
      state.reducedMotion = reducedMotion.matches;
      root.toggleAttribute('data-motion', !state.reducedMotion);
      // With reduced motion nothing moves by itself, so there is nothing to pause: the button keeps its space only.
      pauseButton?.classList.toggle('invisible', state.reducedMotion);
      place();
    };
    reducedMotion.addEventListener('change', applyMotion);

    let intersecting = false;
    const showing = () => {
      state.onScreen = intersecting && !document.hidden;
    };
    new IntersectionObserver(
      ([entry]) => {
        intersecting = !!entry?.isIntersecting;
        showing();
      },
      { threshold: 0.5 },
    ).observe(track);
    document.addEventListener('visibilitychange', showing);

    window.setInterval(() => {
      if (canAutoAdvance(state)) goTo(active + 1);
    }, AUTO_ADVANCE_MS);

    /*
      The preview (D-51, Task 109). The vial in front opens one shared <dialog>. Opening measures the vial, shows the
      dialog with a copy of the same bottle, then, in the first half of PREVIEW_MS, moves that copy from the vial's box
      to its own (FLIP: measure, then animate a transform) while the page darkens; in the second half the cream panel
      opens around the bottle and its words fade in. Closing runs the same steps backwards into the vial now in front.
      Script-driven, so it looks the same in every browser; with reduced motion it opens and closes at once.
    */
    const dialog = root.querySelector<HTMLDialogElement>('[data-mode-preview]');
    const panel = dialog?.querySelector<HTMLElement>('[data-mode-preview-panel]');
    const scrim = dialog?.querySelector<HTMLElement>('[data-mode-preview-scrim]');
    const bottle = dialog?.querySelector<HTMLElement>('[data-mode-preview-vial]');
    const surface = dialog?.querySelector<HTMLElement>('[data-mode-preview-surface]');
    if (dialog && panel && scrim && bottle && surface && typeof dialog.showModal === 'function') {
      const fades = [...dialog.querySelectorAll<HTMLElement>('[data-mode-preview-fade]')];
      const title = dialog.querySelector<HTMLElement>('[data-mode-preview-title]');
      const info = dialog.querySelector<HTMLElement>('[data-infotip]');
      const tryLink = dialog.querySelector<HTMLAnchorElement>('[data-mode-preview-try]');
      const tryLabel = dialog.querySelector<HTMLElement>('[data-mode-preview-try-label]');
      const soon = dialog.querySelector<HTMLElement>('[data-mode-preview-soon]');
      const features = [...dialog.querySelectorAll<HTMLElement>('[data-mode-preview-features]')];
      const previewLive = dialog.querySelector<HTMLElement>('[data-mode-preview-live]');
      let shown = 0;
      let closing = false;
      let returnFocus = true;
      // How far a step nudges the panel sideways: the --nudge-mode-preview token, read once.
      const nudge = getComputedStyle(panel).getPropertyValue('--nudge-mode-preview').trim() || '0px';
      const radius = getComputedStyle(surface).borderTopLeftRadius || '0px';

      /** The vial a mode stands as in the ring. */
      const vialOf = (index: number) => cards[index]!.querySelector<HTMLElement>('[data-vial]') ?? cards[index]!;

      /** While its preview is open, the ring's own bottle steps out of the ring: the one in the preview is it. */
      const lend = (index: number | undefined) => {
        cards.forEach((card, at) => card.toggleAttribute('data-lent', at === index));
      };

      /** Puts a mode's bottle, name, feature rows (behind the ⓘ) and link into the panel. */
      const fill = (index: number) => {
        shown = index;
        const card = cards[index]!;
        const copy = vialOf(index).cloneNode(true) as HTMLElement;
        for (const item of copy.querySelectorAll('[id]')) item.removeAttribute('id');
        bottle.replaceChildren(copy);
        if (title) title.textContent = card.dataset.name ?? '';
        if (info) relabelInfoTip(info, card.dataset.name ?? '');
        const id = card.id.replace(/^mode-/, '');
        for (const list of features) list.hidden = list.dataset.modePreviewFeatures !== id;
        const href = card.dataset.href;
        if (tryLink) {
          tryLink.hidden = !href;
          if (href) tryLink.href = href;
        }
        if (tryLabel) tryLabel.textContent = `start ${card.dataset.name ?? ''}`;
        if (soon) soon.hidden = !!href;
        if (dialog.open) lend(index);
      };

      const moving = () => [bottle, surface, scrim, panel, ...fades];
      const animations = () => moving().flatMap((element) => element.getAnimations());

      /**
       * Stops whatever the preview is doing (a grow, a shrink or a nudge) where it is now, so the next animation starts
       * from what the visitor sees and measures the boxes' own places, not boxes still mid-move. Returns where the
       * bottle, the panel and the words were.
       */
      const stopAll = () => {
        const was = {
          running: animations().length > 0,
          bottle: getComputedStyle(bottle).transform,
          clip: getComputedStyle(surface).clipPath,
          surface: getComputedStyle(surface).opacity,
          words: getComputedStyle(fades[0] ?? panel).opacity,
          shade: getComputedStyle(scrim).opacity,
        };
        for (const animation of animations()) animation.cancel();
        return was;
      };

      const open = (index: number) => {
        if (dialog.open) return;
        takeOver();
        const from = vialOf(index).getBoundingClientRect();
        fill(index);
        if (previewLive) previewLive.textContent = '';
        returnFocus = true;
        quiet = true;
        dialog.showModal();
        lend(index);
        if (state.reducedMotion) return;
        const to = bottle.getBoundingClientRect();
        const box = panel.getBoundingClientRect();
        const around = clipAround(to, box, radius);
        const full = clipAround(box, box, radius);
        const split = PREVIEW_SPLIT;
        const timing = { duration: PREVIEW_MS, easing: PREVIEW_EASING };
        // 1. The same bottle grows from its place toward the middle while the page darkens...
        bottle.animate(
          [{ transform: flipFrom(from, to) }, { transform: 'none', offset: split }, { transform: 'none' }],
          timing,
        );
        scrim.animate([{ opacity: 0 }, { opacity: 1, offset: split }, { opacity: 1 }], { ...timing, easing: 'ease' });
        // 2. ...then the cream panel opens around it, and its words fade in.
        surface.animate(
          [
            { opacity: 0, clipPath: around },
            { opacity: 0, clipPath: around, offset: split - 0.05 },
            { opacity: 1, clipPath: around, offset: split + 0.05 },
            { opacity: 1, clipPath: full },
          ],
          timing,
        );
        for (const words of fades) words.animate([{ opacity: 0 }, { opacity: 0, offset: split }, { opacity: 1 }], timing);
      };

      /** Closes the panel around the bottle, shrinks the bottle back into the vial in front, then closes the dialog. */
      const close = async () => {
        if (!dialog.open || closing) return;
        if (state.reducedMotion) {
          dialog.close();
          return;
        }
        closing = true;
        const into = vialOf(shown).getBoundingClientRect();
        // Closing in the middle of the grow or a nudge closes from where everything is now.
        const was = stopAll();
        const to = bottle.getBoundingClientRect();
        const box = panel.getBoundingClientRect();
        const around = clipAround(to, box, radius);
        const home = flipFrom(into, to);
        const timing = { duration: PREVIEW_MS, easing: PREVIEW_EASING, fill: 'forwards' as const };
        const split = PREVIEW_SPLIT;
        let shrink: Animation;
        if (was.running) {
          // Part-way open: everything goes straight back from where it is.
          shrink = bottle.animate([{ transform: was.bottle }, { transform: home }], timing);
          surface.animate([{ opacity: was.surface, clipPath: was.clip === 'none' ? around : was.clip }, { opacity: 0, clipPath: around }], timing);
          for (const words of fades) words.animate([{ opacity: was.words }, { opacity: 0 }], timing);
          scrim.animate([{ opacity: was.shade }, { opacity: 0 }], { ...timing, easing: 'ease' });
        } else {
          // Fully open: the words fade and the panel closes around the bottle, then the bottle goes home.
          for (const words of fades) words.animate([{ opacity: 1 }, { opacity: 0, offset: split }, { opacity: 0 }], timing);
          surface.animate(
            [
              { opacity: 1, clipPath: clipAround(box, box, radius) },
              { opacity: 1, clipPath: around, offset: split - 0.05 },
              { opacity: 0, clipPath: around, offset: split + 0.05 },
              { opacity: 0, clipPath: around },
            ],
            timing,
          );
          shrink = bottle.animate([{ transform: 'none' }, { transform: 'none', offset: split }, { transform: home }], timing);
          scrim.animate([{ opacity: 1 }, { opacity: 1, offset: split }, { opacity: 0 }], { ...timing, easing: 'ease' });
        }
        try {
          await shrink.finished;
        } catch {
          // Cancelled because the dialog was closed some other way: nothing left to do.
        }
        if (dialog.open) dialog.close();
      };

      /** Previous and next inside the preview: the next mode in the ring's order, and the ring behind follows. */
      const step = (delta: number) => {
        if (closing) return;
        const next = wrap(shown + delta, cards.length);
        // "start …" disappears for a mode that isn't open yet; if it had focus, focus moves to the arrow going that way.
        const tryHadFocus = !!tryLink && document.activeElement === tryLink;
        // A step during the grow finishes the grow at once, so the new bottle and words are simply there.
        for (const animation of animations()) animation.finish();
        fill(next);
        if (tryHadFocus && tryLink?.hidden) {
          dialog.querySelector<HTMLElement>(delta > 0 ? '[data-mode-preview-next]' : '[data-mode-preview-prev]')?.focus();
        }
        goTo(next);
        if (previewLive) previewLive.textContent = slideAnnouncement(cards[next]!.dataset.name ?? '', next, cards.length);
        if (!state.reducedMotion) {
          panel.animate([{ transform: `translateX(calc(${delta} * ${nudge}))` }, { transform: 'none' }], {
            duration: STEP_MS,
            easing: PREVIEW_EASING,
          });
        }
      };

      preview = open;
      dialog.querySelector('[data-mode-preview-close]')?.addEventListener('click', () => void close());
      dialog.querySelector('[data-mode-preview-prev]')?.addEventListener('click', () => step(-1));
      dialog.querySelector('[data-mode-preview-next]')?.addEventListener('click', () => step(1));

      // The darkened page around the panel closes it.
      scrim.addEventListener('click', () => void close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) void close();
      });

      // Escape: shrink back instead of vanishing. Browsers close a modal dialog themselves on Escape; this catches it.
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        void close();
      });

      dialog.addEventListener('keydown', (event) => {
        if (isCloseKey(event.key)) {
          event.preventDefault();
          void close();
          return;
        }
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          step(event.key === 'ArrowRight' ? 1 : -1);
          return;
        }
        // Tab stays inside the preview instead of leaving for the browser's own buttons.
        if (event.key === 'Tab') {
          const items = [...dialog.querySelectorAll<HTMLElement>('a[href]:not([hidden]), button:not([hidden])')].filter(
            (item) => !item.classList.contains('invisible'),
          );
          const index = items.indexOf(document.activeElement as HTMLElement);
          // Safari's own Tab skips links and buttons unless the visitor changed its setting, which would carry focus
          // out of the preview; so every Tab step is taken here, one item at a time, in every browser.
          const target = wrapFocus(index, items.length, event.shiftKey) ?? index + (event.shiftKey ? -1 : 1);
          if (items.length > 0) {
            event.preventDefault();
            items[target]?.focus();
          }
        }
      });

      // On phones, a swipe down from the top of the preview closes it (never a swipe that scrolls a tall preview).
      let touchStart: { x: number; y: number; top: number } | undefined;
      panel.addEventListener(
        'touchstart',
        (event) => {
          const touch = event.touches[0];
          touchStart = event.touches.length === 1 && touch ? { x: touch.clientX, y: touch.clientY, top: dialog.scrollTop } : undefined;
        },
        { passive: true },
      );
      panel.addEventListener(
        'touchend',
        (event) => {
          const touch = event.changedTouches[0];
          const start = touchStart;
          touchStart = undefined;
          if (!start || !touch || start.top > 0 || dialog.scrollTop > 0) return;
          if (isSwipeDown(touch.clientX - start.x, touch.clientY - start.y)) void close();
        },
        { passive: true },
      );

      // A link inside goes somewhere else: close at once, and let focus follow the link.
      for (const link of dialog.querySelectorAll('a')) {
        link.addEventListener('click', () => {
          returnFocus = false;
          dialog.close();
        });
      }

      dialog.addEventListener('close', () => {
        closing = false;
        quiet = false;
        announced = active;
        for (const animation of animations()) animation.cancel();
        bottle.replaceChildren();
        lend(undefined);
        if (returnFocus) openButtons[shown]?.focus({ preventScroll: true });
      });
    }

    // The merry-go-round takes over from the plain row.
    root.toggleAttribute('data-ring', true);
    applyMotion();
    showPaused();
    root.querySelector('[data-modes-controls]')?.classList.remove('invisible');
  }
</script>
