---
/**
 * "ways to study" on the home page (D-50): a small label, a centered heading, one chip per study mode, and a row of
 * cards that scrolls sideways and snaps each card to the middle, with previous, pause and next buttons below. The row
 * runs the full width of the window; the words around it keep the page's width.
 *
 * Without JavaScript it still works: the row scrolls by swiping or the keyboard, and each chip is a link to its card.
 * The script adds the coverflow look, chip and arrow navigation, arrow keys, and a gentle auto-advance that stops for
 * good once the visitor uses the carousel, pauses on hover or focus, and never runs with reduced motion. The pause
 * button stops the auto-advance and the illustration loops (WCAG 2.2.2).
 *
 * The preview (D-51): tapping or clicking a card grows it from its place into a larger preview, a native modal
 * <dialog> over the darkened, softly frosted page, with the mode's illustration playing, two plain lines, "try it"
 * (or "coming soon") and the free-account link. Close it with the X, Escape, a tap on the darkened page or a swipe
 * down; it shrinks back into its card and focus returns there. Previous and next inside move through the modes in
 * the carousel's order. With a mouse, a card grows a little under the pointer or keyboard focus.
 */
import { studyModes } from '../config/modes';
import { accountHref } from '../config/site';
import ModeIllustration from './ModeIllustration.astro';

const count = studyModes.length;
const open = studyModes.filter((mode) => mode.link).map((mode) => mode.name);
const openList = `${open.slice(0, -1).join(', ')} and ${open.at(-1)}`;
---

<section
  id="ways-to-study"
  class="modes mt-section scroll-mt-section"
  aria-labelledby="modes-heading"
  aria-roledescription="carousel"
  data-modes
>
  <div class="mx-auto max-w-page px-gutter text-center">
    <p class="text-sm font-medium tracking-label text-ink-soft">study modes</p>
    <h2 id="modes-heading" class="display mt-3 text-title sm:text-title-lg">ways to study</h2>
  </div>

  <div class="mx-auto mt-8 flex max-w-page flex-wrap justify-center gap-2 px-gutter" role="group" aria-label="pick a study mode">
    {
      studyModes.map((mode, index) => (
        <a
          href={`#mode-${mode.id}`}
          class="mode-chip"
          aria-current={index === 0 ? 'true' : undefined}
          aria-controls="modes-track"
          data-mode-chip
        >
          {mode.name}
        </a>
      ))
    }
  </div>

  <div
    id="modes-track"
    class="modes-track mt-4"
    role="group"
    tabindex="0"
    aria-label="study mode cards"
    data-modes-track
  >
    {
      studyModes.map((mode, index) => (
        <div
          id={`mode-${mode.id}`}
          class="mode-card veil"
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} of ${count}`}
          data-mode-card
          data-name={mode.name}
          data-more={mode.more}
          data-href={mode.link?.href}
        >
          <button
            type="button"
            class="mode-open"
            aria-label={`preview ${mode.name}`}
            aria-haspopup="dialog"
            aria-controls="mode-preview"
            hidden
            data-mode-open
          />
          <div class="mode-art">
            <ModeIllustration mode={mode.id} />
          </div>
          <h3 class="mt-5 text-xl font-medium">{mode.name}</h3>
          <p class="mt-2 flex-1 text-ink-soft">{mode.text}</p>
          {mode.link ? (
            <a href={mode.link.href} class="mt-5 font-medium">
              {mode.link.label}
            </a>
          ) : (
            <p class="mt-5 text-sm text-ink-soft">coming soon</p>
          )}
        </div>
      ))
    }
  </div>

  <div class="invisible relative flex justify-center gap-3" data-modes-controls>
    <button type="button" class="corner-button" aria-label="previous study mode" data-modes-prev>
      <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
        <path d="M14.5 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
    <button type="button" class="corner-button" aria-label="pause the slideshow" data-modes-pause>
      <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false" data-icon-pause>
        <path d="M9 7v10M15 7v10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
      <svg viewBox="0 0 24 24" class="hidden size-6" aria-hidden="true" focusable="false" data-icon-play>
        <path d="M9 6.5l8.5 5.5L9 17.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button type="button" class="corner-button" aria-label="next study mode" data-modes-next>
      <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
        <path d="M9.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <p class="sr-only" aria-live="off" aria-atomic="true" data-modes-live></p>

  <p class="mx-auto mt-8 max-w-page px-gutter text-center text-sm text-ink-soft">
    {openList} are open now, with placeholder cards. the rest are on the way.
  </p>

  <dialog id="mode-preview" class="mode-preview" aria-labelledby="mode-preview-title" data-mode-preview>
    <div class="mode-preview-scrim" data-mode-preview-scrim></div>
    <div class="mode-preview-panel" data-mode-preview-panel>
      <div class="flex justify-end">
        <button type="button" class="corner-button" aria-label="close preview" data-mode-preview-close>
          <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <div class="mode-art mt-2" data-mode-preview-art></div>
      <h2 id="mode-preview-title" class="mt-6 text-2xl font-medium" data-mode-preview-title></h2>
      <p class="mt-3 text-ink-soft" data-mode-preview-more></p>
      <div class="mt-7 flex flex-col items-start gap-4">
        <a href="/" class="glass-button" data-mode-preview-try>try it</a>
        <p class="mode-soon" data-mode-preview-soon>coming soon</p>
        <a href={accountHref} class="text-sm text-ink-soft hover:text-ink">create your free account to save progress</a>
      </div>
      <div class="mt-7 flex justify-center gap-3">
        <button type="button" class="corner-button" aria-label="previous study mode" data-mode-preview-prev>
          <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
            <path d="M14.5 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </button>
        <button type="button" class="corner-button" aria-label="pause the animation" data-mode-preview-pause>
          <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false" data-icon-pause>
            <path d="M9 7v10M15 7v10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          <svg viewBox="0 0 24 24" class="hidden size-6" aria-hidden="true" focusable="false" data-icon-play>
            <path d="M9 6.5l8.5 5.5L9 17.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button" class="corner-button" aria-label="next study mode" data-mode-preview-next>
          <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
            <path d="M9.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <p class="sr-only" aria-live="polite" aria-atomic="true" data-mode-preview-live></p>
    </div>
  </dialog>
</section>

<script>
  import {
    AUTO_ADVANCE_MS,
    PREVIEW_EASING,
    PREVIEW_MS,
    SETTLE_MS,
    STEP_MS,
    canAutoAdvance,
    distance,
    flipFrom,
    isSwipeDown,
    keyTarget,
    nearestIndex,
    slideAnnouncement,
    wrap,
  } from '../scripts/carousel';
  import { isCloseKey, wrapFocus } from '../scripts/menu';

  const root = document.querySelector<HTMLElement>('[data-modes]');
  const track = root?.querySelector<HTMLElement>('[data-modes-track]');

  if (root && track) {
    const cards = [...track.querySelectorAll<HTMLElement>('[data-mode-card]')];
    const chips = [...root.querySelectorAll<HTMLAnchorElement>('[data-mode-chip]')];
    const live = root.querySelector<HTMLElement>('[data-modes-live]');
    const pauseButton = root.querySelector<HTMLButtonElement>('[data-modes-pause]');
    const previewPause = root.querySelector<HTMLButtonElement>('[data-mode-preview-pause]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const state = {
      reducedMotion: reducedMotion.matches,
      paused: false,
      tookOver: false,
      hovering: false,
      focusInside: false,
      onScreen: false,
    };
    let active = 0;
    /** The card last written to the live region (none yet). */
    let announced = -1;
    /** While the preview is open it speaks for itself, so the row behind it stays quiet. */
    let quiet = false;

    const centers = () => cards.map((card) => card.offsetLeft + card.offsetWidth / 2);
    const middle = () => track.scrollLeft + track.clientWidth / 2;

    /** Coverflow: each card's distance from the middle, and which card is in the middle. */
    const update = () => {
      const all = centers();
      const step = cards.length > 1 ? all[1]! - all[0]! : 1;
      const mid = middle();
      cards.forEach((card, index) => card.style.setProperty('--mode-distance', distance(all[index]!, mid, step).toFixed(3)));
      const nearest = nearestIndex(all, mid);
      if (nearest !== active || !cards[nearest]!.hasAttribute('data-active')) setActive(nearest);
    };

    const setActive = (index: number) => {
      active = index;
      cards.forEach((card, i) => card.toggleAttribute('data-active', i === index));
      chips.forEach((chip, i) => {
        if (i === index) chip.setAttribute('aria-current', 'true');
        else chip.removeAttribute('aria-current');
      });
    };

    /**
     * Only the card where the row comes to rest is announced: a swipe, a long glide to a far chip, or a glide the
     * visitor interrupts reads out where it lands, never every card it passes. The cards themselves update at once.
     * At rest means a card sits exactly in the middle, which is where scroll snapping always leaves the row.
     */
    let settle = 0;
    const announce = () => {
      window.clearTimeout(settle);
      update();
      if (!live || announced === active) return;
      if (Math.abs(centers()[active]! - middle()) > 2) return;
      announced = active;
      if (quiet) return;
      live.textContent = slideAnnouncement(cards[active]!.dataset.name ?? '', active, cards.length);
    };
    // scrollend says at once when scrolling, snapping and any glide are over. Not every scroll gets one (in Chrome, a
    // scroll that starts just as another ends can finish without its own), and some browsers have none, so a short
    // pause in scrolling counts too.
    track.addEventListener('scrollend', announce);

    const goTo = (index: number) => {
      const card = cards[wrap(index, cards.length)]!;
      const left = card.offsetLeft + card.offsetWidth / 2 - track.clientWidth / 2;
      track.scrollTo({ left, behavior: state.reducedMotion ? 'auto' : 'smooth' });
    };

    /** Anything the visitor does on the carousel puts them in charge: auto-advance stops and changes are announced. */
    const takeOver = () => {
      state.tookOver = true;
      live?.setAttribute('aria-live', 'polite');
    };

    let frame = 0;
    track.addEventListener(
      'scroll',
      () => {
        window.clearTimeout(settle);
        settle = window.setTimeout(announce, SETTLE_MS);
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          update();
        });
      },
      { passive: true },
    );
    window.addEventListener('resize', update, { passive: true });

    chips.forEach((chip, index) =>
      chip.addEventListener('click', (event) => {
        event.preventDefault();
        takeOver();
        goTo(index);
      }),
    );
    root.querySelector('[data-modes-prev]')?.addEventListener('click', () => {
      takeOver();
      goTo(active - 1);
    });
    root.querySelector('[data-modes-next]')?.addEventListener('click', () => {
      takeOver();
      goTo(active + 1);
    });

    track.addEventListener('keydown', (event) => {
      if (event.target !== track) return;
      const target = keyTarget(event.key, active, cards.length);
      if (target === undefined) return;
      event.preventDefault();
      takeOver();
      goTo(target);
    });

    // A finger or a mouse wheel on the row also puts the visitor in charge.
    track.addEventListener('pointerdown', takeOver, { passive: true });
    track.addEventListener(
      'wheel',
      (event) => {
        // Only sideways scrolling: scrolling the page past the carousel leaves the auto-advance alone.
        if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) takeOver();
      },
      { passive: true },
    );

    root.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') state.hovering = true;
    });
    root.addEventListener('pointerleave', () => {
      state.hovering = false;
    });
    root.addEventListener('focusin', () => {
      state.focusInside = true;
    });
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) state.focusInside = false;
    });

    /** The row's pause button and the preview's share one setting: either one stops every loop. */
    const pauseButtons: Array<[HTMLButtonElement | null, string]> = [
      [pauseButton, 'slideshow'],
      [previewPause, 'animation'],
    ];
    const showPaused = () => {
      root.toggleAttribute('data-paused', state.paused);
      for (const [button, what] of pauseButtons) {
        button?.setAttribute('aria-label', `${state.paused ? 'play' : 'pause'} the ${what}`);
        button?.querySelector('[data-icon-pause]')?.classList.toggle('hidden', state.paused);
        button?.querySelector('[data-icon-play]')?.classList.toggle('hidden', !state.paused);
      }
      live?.setAttribute('aria-live', state.paused || state.tookOver ? 'polite' : 'off');
    };
    pauseButton?.addEventListener('click', () => {
      state.paused = !state.paused;
      // Playing again lets the auto-advance run again, even after the visitor took over.
      if (!state.paused) state.tookOver = false;
      showPaused();
    });
    previewPause?.addEventListener('click', () => {
      // Inside the preview the visitor is already in charge, so playing again restarts only the loops.
      state.paused = !state.paused;
      showPaused();
    });

    const applyMotion = () => {
      state.reducedMotion = reducedMotion.matches;
      root.toggleAttribute('data-motion', !state.reducedMotion);
      // With reduced motion nothing moves by itself, so there is nothing to pause: the buttons keep their space only.
      pauseButton?.classList.toggle('invisible', state.reducedMotion);
      previewPause?.classList.toggle('invisible', state.reducedMotion);
    };
    reducedMotion.addEventListener('change', applyMotion);
    applyMotion();

    let intersecting = false;
    const showing = () => {
      state.onScreen = intersecting && !document.hidden;
    };
    new IntersectionObserver(
      ([entry]) => {
        intersecting = !!entry?.isIntersecting;
        showing();
      },
      { threshold: 0.5 },
    ).observe(track);
    document.addEventListener('visibilitychange', showing);

    window.setInterval(() => {
      if (canAutoAdvance(state)) goTo(active + 1);
    }, AUTO_ADVANCE_MS);

    /*
      The preview (D-51). Each card's preview button opens one shared <dialog>. Opening measures the card, shows the
      dialog, then animates the panel from the card's box to its own (FLIP: measure, then animate a transform), so it
      looks the same in every browser. Closing runs the same animation backwards into the card now in the middle.
    */
    const dialog = root.querySelector<HTMLDialogElement>('[data-mode-preview]');
    const panel = dialog?.querySelector<HTMLElement>('[data-mode-preview-panel]');
    const scrim = dialog?.querySelector<HTMLElement>('[data-mode-preview-scrim]');
    if (dialog && panel && scrim && typeof dialog.showModal === 'function') {
      const openButtons = cards.map((card) => card.querySelector<HTMLButtonElement>('[data-mode-open]'));
      const art = dialog.querySelector<HTMLElement>('[data-mode-preview-art]');
      const title = dialog.querySelector<HTMLElement>('[data-mode-preview-title]');
      const more = dialog.querySelector<HTMLElement>('[data-mode-preview-more]');
      const tryLink = dialog.querySelector<HTMLAnchorElement>('[data-mode-preview-try]');
      const soon = dialog.querySelector<HTMLElement>('[data-mode-preview-soon]');
      const previewLive = dialog.querySelector<HTMLElement>('[data-mode-preview-live]');
      let shown = 0;
      let closing = false;
      let returnFocus = true;

      /** Puts a mode's illustration, name, lines and link into the panel. */
      const fill = (index: number) => {
        shown = index;
        const card = cards[index]!;
        const drawing = card.querySelector('.ill');
        art?.replaceChildren(...(drawing ? [drawing.cloneNode(true)] : []));
        if (title) title.textContent = card.dataset.name ?? '';
        if (more) more.textContent = card.dataset.more ?? '';
        const href = card.dataset.href;
        if (tryLink) {
          tryLink.hidden = !href;
          if (href) tryLink.href = href;
        }
        if (soon) soon.hidden = !!href;
      };

      const animations = () => [...panel.getAnimations(), ...scrim.getAnimations()];

      /**
       * Stops whatever the panel is doing (a grow, a shrink or a nudge) where it is now, so the next animation starts
       * from what the visitor sees and measures the panel's own box, not a box still mid-move. Returns where it was.
       */
      const stopPanel = () => {
        const transform = getComputedStyle(panel).transform;
        for (const animation of panel.getAnimations()) animation.cancel();
        return transform === 'none' ? 'none' : transform;
      };

      const open = (index: number) => {
        if (dialog.open) return;
        takeOver();
        const card = cards[index]!.getBoundingClientRect();
        fill(index);
        if (previewLive) previewLive.textContent = '';
        returnFocus = true;
        quiet = true;
        dialog.showModal();
        if (state.reducedMotion) return;
        const box = panel.getBoundingClientRect();
        panel.animate([{ transform: flipFrom(card, box) }, { transform: 'none' }], {
          duration: PREVIEW_MS,
          easing: PREVIEW_EASING,
        });
        scrim.animate([{ opacity: 0 }, { opacity: 1 }], { duration: PREVIEW_MS, easing: 'ease' });
      };

      /** Shrinks the panel back into the card it shows, then closes the dialog. */
      const close = async () => {
        if (!dialog.open || closing) return;
        if (state.reducedMotion) {
          dialog.close();
          return;
        }
        closing = true;
        const card = cards[shown]!.getBoundingClientRect();
        // Closing in the middle of the grow or a nudge shrinks from where the panel is now.
        const from = stopPanel();
        const shade = getComputedStyle(scrim).opacity;
        for (const animation of scrim.getAnimations()) animation.cancel();
        const box = panel.getBoundingClientRect();
        const timing = { duration: PREVIEW_MS, easing: PREVIEW_EASING, fill: 'forwards' as const };
        const shrink = panel.animate([{ transform: from }, { transform: flipFrom(card, box) }], timing);
        scrim.animate([{ opacity: shade }, { opacity: 0 }], { ...timing, easing: 'ease' });
        try {
          await shrink.finished;
        } catch {
          // Cancelled because the dialog was closed some other way: nothing left to do.
        }
        if (dialog.open) dialog.close();
      };

      /** Previous and next inside the preview: the next mode in the carousel's order, and the row behind follows. */
      const step = (delta: number) => {
        if (closing) return;
        const next = wrap(shown + delta, cards.length);
        // "try it" disappears for a mode that isn't open yet; if it had focus, focus moves to the arrow going that way.
        const tryHadFocus = !!tryLink && document.activeElement === tryLink;
        fill(next);
        if (tryHadFocus && tryLink?.hidden) {
          dialog.querySelector<HTMLElement>(delta > 0 ? '[data-mode-preview-next]' : '[data-mode-preview-prev]')?.focus();
        }
        goTo(next);
        if (previewLive) previewLive.textContent = slideAnnouncement(cards[next]!.dataset.name ?? '', next, cards.length);
        if (!state.reducedMotion) {
          // A step during the grow finishes the grow from where it is, instead of jumping back to its start later.
          const from = stopPanel();
          panel.animate([{ transform: from === 'none' ? `translateX(${delta * 16}px)` : from }, { transform: 'none' }], {
            duration: STEP_MS,
            easing: PREVIEW_EASING,
          });
        }
      };

      openButtons.forEach((button, index) => {
        button?.addEventListener('click', () => open(index));
        if (button) button.hidden = false;
      });
      dialog.querySelector('[data-mode-preview-close]')?.addEventListener('click', () => void close());
      dialog.querySelector('[data-mode-preview-prev]')?.addEventListener('click', () => step(-1));
      dialog.querySelector('[data-mode-preview-next]')?.addEventListener('click', () => step(1));

      // The darkened page around the panel closes it.
      scrim.addEventListener('click', () => void close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) void close();
      });

      // Escape: shrink back instead of vanishing. Browsers close a modal dialog themselves on Escape; this catches it.
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        void close();
      });

      dialog.addEventListener('keydown', (event) => {
        if (isCloseKey(event.key)) {
          event.preventDefault();
          void close();
          return;
        }
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          step(event.key === 'ArrowRight' ? 1 : -1);
          return;
        }
        // Tab stays inside the preview instead of leaving for the browser's own buttons.
        if (event.key === 'Tab') {
          const items = [...dialog.querySelectorAll<HTMLElement>('a[href]:not([hidden]), button:not([hidden])')].filter(
            (item) => !item.classList.contains('invisible'),
          );
          const target = wrapFocus(items.indexOf(document.activeElement as HTMLElement), items.length, event.shiftKey);
          if (target !== undefined) {
            event.preventDefault();
            items[target]?.focus();
          }
        }
      });

      // On phones, a swipe down from the top of the preview closes it (never a swipe that scrolls a tall preview).
      let touchStart: { x: number; y: number; top: number } | undefined;
      panel.addEventListener(
        'touchstart',
        (event) => {
          const touch = event.touches[0];
          touchStart = event.touches.length === 1 && touch ? { x: touch.clientX, y: touch.clientY, top: dialog.scrollTop } : undefined;
        },
        { passive: true },
      );
      panel.addEventListener(
        'touchend',
        (event) => {
          const touch = event.changedTouches[0];
          const start = touchStart;
          touchStart = undefined;
          if (!start || !touch || start.top > 0 || dialog.scrollTop > 0) return;
          if (isSwipeDown(touch.clientX - start.x, touch.clientY - start.y)) void close();
        },
        { passive: true },
      );

      // A link inside goes somewhere else: close at once, and let focus follow the link.
      for (const link of dialog.querySelectorAll('a')) {
        link.addEventListener('click', () => {
          returnFocus = false;
          dialog.close();
        });
      }

      dialog.addEventListener('close', () => {
        closing = false;
        quiet = false;
        announced = active;
        for (const animation of animations()) animation.cancel();
        art?.replaceChildren();
        if (returnFocus) openButtons[shown]?.focus({ preventScroll: true });
      });
    }

    showPaused();
    update();
    root.querySelector('[data-modes-controls]')?.classList.remove('invisible');
  }
</script>
