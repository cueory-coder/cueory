---
import { site } from '../config/site';

interface Props {
  /** The study screen gets a quieter header with fewer links. */
  quiet?: boolean;
}

const { quiet = false } = Astro.props;
---

<header class="mx-auto flex w-full max-w-page items-center justify-between gap-4 px-gutter py-5">
  <a href="/" class="font-display text-xl text-ink no-underline hover:text-ink">{site.name}</a>
  {
    !quiet && (
      <nav aria-label="Main">
        <ul class="flex items-center gap-5 text-sm">
          <li>
            <a href="/learn/study-skills" class="text-ink-soft no-underline hover:text-ink hover:underline">
              Start learning
            </a>
          </li>
        </ul>
      </nav>
    )
  }
</header>
