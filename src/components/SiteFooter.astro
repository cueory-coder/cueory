---
import SocialLinks from './SocialLinks.astro';
import ThemePicker from './ThemePicker.astro';
import { footerLinks, site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="mt-section border-t border-line">
  <div class="mx-auto flex w-full max-w-page flex-col gap-8 px-gutter py-10 text-sm sm:flex-row sm:items-start sm:gap-12">
    <!-- Brand column: tagline, copyright, contact -->
    <div class="flex flex-1 flex-col gap-2">
      <p class="font-medium text-ink">{site.tagline}</p>
      <p class="text-ink-soft">© {year} {site.wordmarkName}. study help, not medical advice.</p>
      {
        site.contactEmail && (
          <p>
            <a href={`mailto:${site.contactEmail}`} class="text-ink-soft hover:text-ink">
              {site.contactEmail}
            </a>
          </p>
        )
      }
      <SocialLinks />
    </div>

    <!-- Nav links column -->
    <nav aria-label="footer" class="flex shrink-0 flex-col gap-2">
      {
        footerLinks.map((link) => (
          <a href={link.href} class="text-ink-soft hover:text-ink">
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Theme switch column -->
    <div class="shrink-0">
      <ThemePicker />
    </div>
  </div>
</footer>
