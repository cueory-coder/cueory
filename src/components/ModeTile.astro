---
/**
 * Task 81 lesson-hub tile. Display copy and destinations come from modes.ts.
 * Keep the full, visible action-link wording for keyboard users and legacy tests.
 * The mode's line waits behind the ⓘ beside its name (Christian, 2026-11-02).
 */
import InfoTip from './InfoTip.astro';
import ModeIllustration from './ModeIllustration.astro';
import type { StudyMode } from '../config/modes';

interface Props {
  mode: StudyMode;
  linkLabel: string;
  /** Per-lesson destination while keeping the current accessible tile presentation. */
  href?: string;
}

const { mode, linkLabel, href } = Astro.props;
// Never fall back to mode.link: that destination belongs to the home-page sample.
---

<article
  class="study-mode-tile lift flex h-full min-w-0 flex-col rounded-xl border border-line bg-surface p-3 sm:p-5"
  data-mode-tile={mode.id}
  data-mode-status={href ? 'available' : 'coming-soon'}
>
  <div class="mode-art mb-3 overflow-hidden" aria-hidden="true">
    <ModeIllustration mode={mode.id} />
  </div>
  <div class="-mt-2 mb-2 flex min-w-0 flex-wrap items-center">
    <h3 class="min-w-0 wrap-anywhere text-lg font-semibold">{mode.name}</h3>
    <InfoTip id={`mode-tile-${mode.id}-info`} label={mode.name} text={mode.text} />
  </div>
  {href ? (
    <a
      href={href}
      class="mt-auto inline-flex min-h-11 items-center rounded-md border border-control px-3 py-2 text-sm font-medium text-ink no-underline hover:bg-page focus-visible:bg-page"
    >
      <span class="min-w-0">{linkLabel}</span>
      <span class="ml-2 shrink-0" aria-hidden="true">→</span>
    </a>
  ) : (
    <p class="mt-auto flex min-h-11 items-center rounded-md border border-line bg-page px-3 py-2 text-sm font-medium text-ink-soft">
      coming soon
    </p>
  )}
</article>

<style>
  .study-mode-tile {
    box-shadow: var(--shadow-card, var(--shadow-soft));
  }

  .study-mode-tile:focus-within {
    box-shadow: var(--shadow-card-hover, var(--shadow-soft));
  }
</style>
