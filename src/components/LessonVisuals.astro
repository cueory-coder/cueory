---
import { getCollection } from 'astro:content';
import VisualDiagram from '../visuals/VisualDiagram';
import { creditsFor } from '../visuals/credits';
import { visualsForLesson } from '../visuals/forlesson';

interface Props {
  /** The lesson's id as the visuals' `lessonIds` name it (for example U01-T01-L01). */
  lessonId: string;
}

const { lessonId } = Astro.props;
const shown = visualsForLesson((await getCollection('visuals')).map((entry) => entry.data), lessonId);
const credits = creditsFor(shown);
---

{
  shown.length > 0 && (
    <div class="mt-section space-y-section" data-lesson-visuals>
      {shown.map((visual) => (
        <div data-visual={visual.id}>
          <VisualDiagram client:only="react" visual={visual} />
        </div>
      ))}
      {credits.length > 0 && (
        <p class="text-sm text-ink-soft" data-visual-credits>
          {credits.map((book, index) => (
            <>
              {index > 0 && ' '}
              {book.credit}{' '}
              <a href={book.licenseUrl} rel="license noopener">the license</a>
            </>
          ))}
        </p>
      )}
    </div>
  )
}
