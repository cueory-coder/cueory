---
import FlagMount from '../islands/FlagMount';

interface Props {
  page: string;
  flagItem?: { itemId: string; itemVersionId: string };
}

const { page, flagItem } = Astro.props;
---

<aside class="mt-8 pb-4" aria-label="flag or comment">
  <FlagMount client:idle page={page} itemId={flagItem?.itemId} itemVersionId={flagItem?.itemVersionId} />
</aside>
