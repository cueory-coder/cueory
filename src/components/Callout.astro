---
/**
 * One quiet, reusable reading note. The icon supplements a visible word label, never replaces it.
 * No raw palette colors, third-party icons, scripts, or animation.
 */
type Kind = 'note' | 'remember' | 'try-it';
interface Props {
  kind: Kind;
}
const { kind } = Astro.props;
const labels: Record<Kind, string> = {
  note: 'note',
  remember: 'remember',
  'try-it': 'try it',
};
---

<aside role="note" data-callout-kind={kind} class="mt-8 rounded-lg border border-line bg-surface p-5 text-ink">
  <div class="flex items-center gap-3">
    <svg
      class="size-5 shrink-0"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {kind === 'note' && <circle cx="12" cy="12" r="9" />}
      {kind === 'note' && <path d="M12 11v5 M12 8h.01" />}
      {kind === 'remember' && <path d="M6 4h12v16l-6-4-6 4V4z" />}
      {kind === 'try-it' && <circle cx="12" cy="12" r="9" />}
      {kind === 'try-it' && <path d="m8 12 3 3 5-6" />}
    </svg>
    <span class="text-sm font-semibold tracking-label">{labels[kind]}</span>
  </div>
  <div class="mt-3">
    <slot />
  </div>
</aside>
