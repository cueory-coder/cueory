---
/**
 * A unit row in the approved course-library design.
 * Native details/summary keeps every topic list usable by keyboard without JavaScript.
 */
import type { MapUnit } from '../islands/lessonmap';
import type { CatalogLesson } from '../lessons/catalog';
import { unitAvailability } from '../lessons/availability';

interface Props {
  unit: MapUnit;
  position: number;
  /** Only lessons the public catalog builds can become links. */
  lessons: readonly CatalogLesson[];
}

const { unit, lessons } = Astro.props;
const availability = unitAvailability(lessons, unit.id);
const lessonCount = unit.topics.reduce((count, topic) => count + topic.lessons.length, 0);
---

<article data-unit-id={unit.id} class="unit-card lift h-full min-w-0 overflow-hidden rounded-xl border border-line bg-surface">
  <details class="unit-details">
    <summary class="flex min-h-14 cursor-pointer items-center gap-3 p-4 focus-visible:outline-2 focus-visible:outline-focus focus-visible:outline-offset-2">
      <span class="min-w-0 flex-1">
        <span role="heading" aria-level="3" class="block text-sm font-medium text-ink">{unit.title}</span>
        <span class="mt-1 block text-sm text-ink-soft">{availability.hasLessons ? `${availability.open.length} open now` : 'coming soon'}</span>
      </span>
      <span class="shrink-0 text-sm font-medium text-ink-soft" aria-hidden="true">{lessonCount}</span>
      <span class="chevron shrink-0 text-ink-soft" aria-hidden="true">›</span>
    </summary>
    <div class="border-t border-line px-4 pb-4 pt-3">
      <p class="text-sm text-ink-soft">{lessonCount} {lessonCount === 1 ? 'lesson' : 'lessons'} planned · topics</p>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-ink">
        {unit.topics.map((topic) => <li>{topic.title}</li>)}
      </ul>
      {availability.hasLessons ? (
        <>
          <p class="mt-4 text-sm text-ink-soft">open now</p>
          <ul class="mt-2 space-y-2 text-sm">
            {availability.open.map((lesson) => <li><a href={lesson.href} class="inline-flex min-h-11 items-center underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-focus">{lesson.name}</a></li>)}
          </ul>
        </>
      ) : (
        <p data-testid="unit-empty-state" class="mt-4 text-sm text-ink-soft">no lessons yet · coming soon</p>
      )}
    </div>
  </details>
</article>

<style>
  .unit-card {
    box-shadow: var(--shadow-card, var(--shadow-soft));
  }
  .unit-card:focus-within {
    box-shadow: var(--shadow-card-hover, var(--shadow-soft));
  }
  .unit-details > summary {
    list-style: none;
  }
  .unit-details > summary::-webkit-details-marker {
    display: none;
  }
  .unit-details[open] .chevron {
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .unit-details[open] .chevron {
      transform: none;
    }
  }
</style>
