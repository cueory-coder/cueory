---
/**
 * The cueory logo: Christian's brand v1.0 artwork (brand-source/v1.0/, DECISIONS.md D-55). Never retype it in a
 * font, trace, redraw, emboss, shadow or recolor it (brand guide §3.6). The web copies in public/brand/v1/ are built
 * by scripts/build-brand-v1.mjs: Espresso artwork for the Daytime palette and Ivory artwork for the Evening palette,
 * on transparent backgrounds. Both are in the page; global.css (.logo-day, .logo-evening) shows the one that matches
 * the palette, with the same rules tokens.css uses.
 *
 * variant "full" (default): the wordmark with the cruet. Guide §3.5: about 240px wide or more where it fits.
 * variant "emblem": the water-drop c with the cruet, for compact places such as study screens.
 *
 * Size it with a width class. Decorative by default (empty alt text): name the link around it, or pass `label` when
 * the logo stands alone.
 */
interface Props {
  variant?: 'full' | 'emblem';
  /** How wide the logo shows, so the browser picks the right file (the img `sizes` attribute). */
  sizes?: string;
  /** Accessible name, when nothing around the logo names the brand. */
  label?: string;
  class?: string;
  /** Header logos and home hero opt out of lazy loading. */
  loading?: 'lazy' | 'eager';
}

const files = {
  full: { name: 'logo-full', widths: [480, 960, 1440], width: 960, height: 303 },
  emblem: { name: 'emblem', widths: [96, 192, 384], width: 384, height: 428 },
} as const;

const { variant = 'full', sizes, label, class: className, loading = 'lazy' } = Astro.props;
const art = files[variant];
const path = (mode: 'light' | 'dark', width: number) => `/brand/v1/${art.name}-${mode}-${width}.png`;
const srcset = (mode: 'light' | 'dark') => art.widths.map((width) => `${path(mode, width)} ${width}w`).join(', ');
const shownAt = sizes ?? (variant === 'full' ? '15rem' : '2.25rem');
---

<span class:list={['logo', className]} role={label ? 'img' : undefined} aria-label={label}>
  <img
    class="logo-day"
    src={path('light', art.widths[1])}
    srcset={srcset('light')}
    sizes={shownAt}
    width={art.width}
    height={art.height}
    alt=""
    aria-hidden="true"
    loading={loading}
    data-image-priority={loading === 'eager' ? 'header' : undefined}
    decoding="async"
    draggable="false"
  />
  <img
    class="logo-evening"
    src={path('dark', art.widths[1])}
    srcset={srcset('dark')}
    sizes={shownAt}
    width={art.width}
    height={art.height}
    alt=""
    aria-hidden="true"
    loading={loading}
    data-image-priority={loading === 'eager' ? 'header' : undefined}
    decoding="async"
    draggable="false"
  />
</span>
