---
/**
 * A quiet, reusable empty state for study screens (Task 91).
 * The optional action navigates to a real page, so it is a link styled as a button.
 * Icons are decorative only. The text conveys the whole message without them.
 */
interface Props {
  title: string;
  description: string;
  icon?: 'search' | 'book' | 'check';
  actionLabel?: string;
  actionHref?: string;
  /** Reload the current page (or a supplied URL) to try again. */
  retryLabel?: string;
  retryHref?: string;
  headingLevel?: 2 | 3;
}

const {
  title,
  description,
  icon,
  actionLabel,
  actionHref,
  retryLabel,
  retryHref,
  headingLevel = 2,
} = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
const hasAction = Boolean(actionLabel && actionHref);
const hasRetry = Boolean(retryLabel);
---

<section
  data-empty-state
  aria-label={title}
  class="mx-auto flex w-full max-w-prose flex-col items-center rounded-xl border border-line bg-page px-6 py-10 text-center shadow-card sm:px-10"
>
  {icon && (
    <span
      data-empty-icon={icon}
      class="mb-4 flex h-11 w-11 items-center justify-center rounded-full border border-line bg-surface text-ink"
      aria-hidden="true"
    >
      {icon === 'search' && (
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <circle cx="10.5" cy="10.5" r="6.5" />
          <path d="m16 16 4 4" />
        </svg>
      )}
      {icon === 'book' && (
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M12 5C9 3 6 3 3 4v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Z" />
          <path d="M12 5v15" />
        </svg>
      )}
      {icon === 'check' && (
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <circle cx="12" cy="12" r="9" />
          <path d="m8 12 3 3 5-6" />
        </svg>
      )}
    </span>
  )}

  <Heading class="text-lg font-semibold text-ink">{title}</Heading>
  <p class="mt-2 max-w-prose text-sm text-ink-soft">{description}</p>

  {hasAction && (
    <a
      href={actionHref}
      class="lift press mt-6 inline-flex min-h-11 min-w-11 items-center justify-center rounded-pill bg-button px-6 py-3 text-sm font-semibold text-on-button"
    >
      {actionLabel}
    </a>
  )}
  {hasRetry && (
    <form method="get" action={retryHref} class="mt-6">
      <button
        type="submit"
        class="lift press inline-flex min-h-11 min-w-11 items-center justify-center rounded-pill bg-button px-6 py-3 text-sm font-semibold text-on-button"
      >
        {retryLabel}
      </button>
    </form>
  )}
</section>
