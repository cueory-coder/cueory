---
import '../styles/global.css';
import BuildingNotice from '../components/BuildingNotice.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../config/site';
import { themeHeadScript } from '../scripts/theme';

interface Props {
  title: string;
  description?: string;
  /**
   * 'study' is the quieter lesson screen (plain background, no decoration). 'home' is the home page: a full-screen
   * hero with its own logo instead of the header. Every other page gets the marketing look (D-41).
   */
  variant?: 'default' | 'study' | 'home';
  /** Keep this page out of search engines. */
  noindex?: boolean;
}

const { title, description = site.description, variant = 'default', noindex = false } = Astro.props;
const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const isStudy = variant === 'study';
const isHome = variant === 'home';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f9f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1715" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Applies a saved Light or Dark pick before the page paints (ThemePicker.astro, src/scripts/theme.ts). -->
    <script is:inline set:html={themeHeadScript} />
    {
      /* Marketing pages fetch their serif early so it is ready before the page is drawn (font-display: optional). */
      !isStudy && (
        <link rel="preload" href="/fonts/bodoni-moda-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
      )
    }
    {isHome && <link rel="preload" href="/fonts/bodoni-moda-latin-opsz-italic.woff2" as="font" type="font/woff2" crossorigin />}
  </head>
  <body class:list={['flex flex-col', isStudy ? 'bg-page' : 'silk-quiet']}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:bg-surface focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <BuildingNotice />
    {!isHome && <SiteHeader quiet={isStudy} />}
    <main id="main" class:list={['w-full flex-1', !isHome && 'mx-auto max-w-page px-gutter']}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
