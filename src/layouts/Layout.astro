---
import '../styles/global.css';
import '../styles/print.css';
import BuildingNotice from '../components/BuildingNotice.astro';
import PromoPanel from '../components/PromoPanel.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { offline, promo as promoSettings, site } from '../config/site';
import { themeHeadScript } from '../scripts/theme';

interface Props {
  title: string;
  description?: string;
  /**
   * 'study' is the quieter lesson screen (plain background, no decoration, quiet corner buttons). 'home' is the home
   * page: a full-screen hero with its own logo, so the header there is just the ☰ and account corners laid over it
   * (D-46). Every other page gets the marketing look (D-41).
   */
  variant?: 'default' | 'study' | 'home';
  /** Keep this page out of search engines. */
  noindex?: boolean;
  /**
   * The once-only promo panel (D-59). Marketing pages show it unless they turn it off (the signup thank-you page does,
   * because its visitor has just joined); study screens never do.
   */
  promo?: boolean;
  /**
   * The real item a question page shows, for its flag reports: the database item id and item version id (uuids).
   * Sample pages pass none (Task 171). A slug or half a pair fails the build.
   */
  flagItem?: { itemId: string; itemVersionId: string };
  /** Hide the flag-or-comment button (D-pending, Task 64): set true during sharpening rounds and timed reviews. */
  hideFlag?: boolean;
}

const { title, description = site.description, variant = 'default', noindex = false, promo = true, flagItem, hideFlag = false } = Astro.props;
// Browser-tab titles use the lowercase brand voice: "privacy · cueory" (D-47).
const fullTitle = title === site.name || title === site.wordmarkName ? site.wordmarkName : `${title} · ${site.wordmarkName}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const isStudy = variant === 'study';
const isHome = variant === 'home';
const showPromo = promoSettings.show && promo && !isStudy;
// The title a page has in site search results (D-49): its own title, and "home" for the home page.
const searchTitle = isHome ? 'home' : title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Brand v1.0 icons (D-55): the emblem on Ivory, built by scripts/build-brand-v1.mjs. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/v1/icon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/v1/icon-192.png" />
    <link rel="apple-touch-icon" href="/brand/v1/icon-180.png" />
    <meta name="theme-color" content="#f9f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1917" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Applies a saved Light or Dark pick before the page paints (ThemePicker.astro, src/scripts/theme.ts). -->
    <script is:inline set:html={themeHeadScript} />
    {
      /* Marketing pages fetch their serif early so it is ready before the page is drawn (font-display: optional). */
      !isStudy && (
        <link rel="preload" href="/fonts/bodoni-moda-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
      )
    }
  </head>
  <body class:list={['flex flex-col', isStudy ? 'bg-page' : 'silk-quiet']}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:bg-surface focus:px-4 focus:py-2"
    >
      skip to content
    </a>
    <BuildingNotice />
    {
      isHome ? (
        <div class="relative z-20 h-0">
          <SiteHeader overlay />
        </div>
      ) : (
        <SiteHeader quiet={isStudy} />
      )
    }
    <!--
      Site search (D-49) indexes only this main area of each page, never the menus, notice or footer, and leaves out
      pages kept out of search engines (404, the signup thank-you page). Results are titled by the page's own title.
    -->
    <main
      id="main"
      class:list={['w-full flex-1', !isHome && 'mx-auto max-w-page px-gutter']}
      data-pagefind-body={noindex ? undefined : ''}
      data-pagefind-meta={noindex ? undefined : `title:${searchTitle}`}
    >
      <slot />
    </main>
    <SiteFooter hideFlag={hideFlag} flagItem={flagItem} />
    {showPromo && <PromoPanel />}
    <!--
      Offline copies of pages (ROADMAP Task 5): an external file (built from src/scripts/offline.ts) that registers
      /sw.js after the page has loaded, in a built site only and while `offline.enabled` (src/config/site.ts) is true.
    -->
    <script is:inline src="/register-sw.js" defer data-offline={import.meta.env.PROD && offline.enabled ? 'on' : 'off'}></script>
  </body>
</html>
