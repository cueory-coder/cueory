---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  hideChrome?: boolean;
}
const { title, description, hideChrome = false } = Astro.props;
const pageTitle = title === "Cueory" ? title : `${title} · Cueory`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2decb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#241b19" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    {!hideChrome && <SiteHeader />}
    <main id="main"><slot /></main>
    {!hideChrome && <SiteFooter />}
  </body>
</html>
