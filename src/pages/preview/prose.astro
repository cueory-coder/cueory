---
import Layout from '../../layouts/Layout.astro';
import Prose from '../../components/Prose.astro';
import Callout from '../../components/Callout.astro';
import ContentLabel from '../../components/ContentLabel.astro';
import PlaceholderBlock from '../../components/PlaceholderBlock.astro';
---

<!-- Locked, noindex sample-only reading preview. Never treat this content as a real lesson. -->
<Layout
  title="reading preview"
  description="a private preview of cueory reading styles, sample callouts, content labels and placeholders."
  noindex
  promo={false}
>
  <Prose>
    <h1>reading preview</h1>
    <p>
      [sample introductory paragraph] <strong class="key-term">[sample key term]</strong>
      [sample continuation].
    </p>
    <p>[sample second paragraph with longer reading text for checking layout and reflow.]</p>

    <h2>paragraph rhythm</h2>
    <p>[sample prose paragraph for inspecting reading width and line spacing on every device.]</p>
    <h3>smaller headings</h3>
    <p>[sample text beneath a smaller heading.]</p>
    <ul>
      <li>[sample unordered item one]</li>
      <li>[sample unordered item two]</li>
      <li>[sample unordered item three]</li>
    </ul>
    <ol>
      <li>[sample ordered item one]</li>
      <li>[sample ordered item two]</li>
    </ol>

    <h2>callout examples</h2>
    <Callout kind="note">
      <p>[sample note]</p>
    </Callout>
    <Callout kind="remember">
      <p>[sample remember item]</p>
    </Callout>
    <Callout kind="try-it">
      <p>[sample activity]</p>
    </Callout>

    <ContentLabel class="mt-8 [&_a]:inline-flex [&_a]:min-h-11 [&_a]:items-center" />
    <PlaceholderBlock label="[sample placeholder heading]">
      <p>[sample placeholder body]</p>
    </PlaceholderBlock>
  </Prose>
</Layout>
