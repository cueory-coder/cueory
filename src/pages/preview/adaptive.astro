---
/** Noindex, staging-only preview. Never show sample quiz UI in the live build. */
import Layout from '../../layouts/Layout.astro';
import AdaptiveQuiz from '../../islands/AdaptiveQuiz';
import { draftsAllowed } from '../../islands/anatomylab';

const visible = draftsAllowed({
  WORKERS_CI: process.env.WORKERS_CI,
  WORKERS_CI_BRANCH: process.env.WORKERS_CI_BRANCH,
  CUEORY_ANATOMY_DRAFTS: process.env.CUEORY_ANATOMY_DRAFTS,
});
---

<Layout title="adaptive quiz sample preview"
  description="Try the adaptive quiz rules with labeled samples without saving answers or progress."
  variant="study" promo={false} noindex>
  <div class="mx-auto w-full max-w-prose py-section" data-pagefind-ignore>
    <header class="space-y-3">
      <h1 class="text-2xl">adaptive quiz preview</h1>
      <p class="text-ink-soft">this is a rules preview with labeled samples only. it does not track you or predict an exam result.</p>
    </header>
    {visible ? (
      <AdaptiveQuiz client:only="react">
        <p slot="fallback" role="status" class="mt-6 text-sm text-ink-soft">loading sample preview…</p>
      </AdaptiveQuiz>
    ) : (
      <p class="mt-6" data-testid="adaptive-preview-closed">this sample preview is not available on the live site.</p>
    )}
    <a href="/learn"
      class="mt-8 inline-flex min-h-11 items-center rounded-pill border border-control px-5 py-3 no-underline hover:bg-surface">
      back to the course library
    </a>
  </div>
</Layout>
