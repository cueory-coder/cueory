---
/**
 * Preview-only (Task 66): the /admin/flags table with made-up sample rows, so its layout, keyboard use and
 * accessibility can be checked in a browser before Task 65's database functions exist. The rows live in this
 * browser only; nothing is read from or sent to the database. Not linked from the site.
 */
import Layout from '../../layouts/Layout.astro';
import AdminFlags from '../../islands/AdminFlags.tsx';
import type { FlagRow } from '../../islands/flaginbox';

const sample = (n: number) => `00000000-0000-4000-8000-${String(n).padStart(12, '0')}`;
const student = sample(900);

// Made-up sample reports. Not real questions, students or comments.
const sampleRows: FlagRow[] = [
  {
    id: sample(1), user_id: student, page: '/learn/study-skills/questions', item_id: sample(101), item_version_id: sample(201),
    reason: 'typo', comment: 'sample comment: the second sentence repeats a word.', status: 'open',
    created_at: '2026-11-01T15:00:00Z', handled_at: null,
  },
  {
    id: sample(2), user_id: student, page: '/learn/study-skills/questions', item_id: sample(101), item_version_id: sample(201),
    reason: 'confusing', comment: '<img src=x onerror=alert(1)> sample comment written to look like html', status: 'open',
    created_at: '2026-11-01T16:30:00Z', handled_at: null,
  },
  {
    id: sample(3), user_id: student, page: '/play', item_id: null, item_version_id: null,
    reason: 'broken', comment: null, status: 'open', created_at: '2026-11-02T09:15:00Z', handled_at: null,
  },
  {
    id: sample(4), user_id: student, page: '/learn/study-skills/cards', item_id: null, item_version_id: null,
    reason: 'other', comment: 'sample comment: already looked at.', status: 'handled',
    created_at: '2026-10-31T12:00:00Z', handled_at: '2026-11-01T08:00:00Z',
  },
];
---

<Layout
  title="preview: report inbox"
  description="Internal preview of cueory's report inbox with sample rows."
  variant="study"
  noindex
  promo={false}
>
  <div class="mx-auto max-w-page py-8">
    <p class="text-sm text-ink-soft">internal preview · not linked from the site · made-up sample rows, kept in this browser only</p>
    <div class="mt-6">
      <AdminFlags client:only="react" sampleRows={sampleRows} />
      <noscript>
        <p class="text-sm text-ink-soft">the sample report inbox needs javascript. no reports are sent or changed on this preview page.</p>
      </noscript>
    </div>
  </div>
</Layout>
