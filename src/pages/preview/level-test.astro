---
import Layout from '../../layouts/Layout.astro';
import LevelTest from '../../islands/LevelTest';
---

<Layout
  title="sample unit level test"
  description="Try a short unit level-test preview with labeled samples and plain-language results."
  variant="study"
  noindex
  promo={false}
>
  <div data-testid="level-test-page" class="mx-auto max-w-prose space-y-6 py-section">
    <header>
      <p class="text-sm text-ink-soft">preview only · not a real course</p>
      <h1 class="mt-2 text-2xl font-semibold">sample unit level test</h1>
      <p class="mt-3 text-ink-soft">
        try the level-test rules with labeled sample questions. this is not an assessment.
        choices stay on this page only, and are not saved or sent anywhere.
      </p>
    </header>
    <LevelTest client:only="react" />
    <noscript><p>turn on javascript to try the sample unit level test.</p></noscript>
  </div>
</Layout>
