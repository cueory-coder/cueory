---
/* Preview page for the share sheet component (Task 103, D-pending). Never indexed or linked in production. */
import Layout from '../../layouts/Layout.astro';
import ShareSheet from '../../islands/ShareSheet';
import { site } from '../../config/site';
import { gameName } from '../../config/games';
---

<Layout
  title="share preview"
  description="A private preview of the share sheet component."
  noindex
  promo={false}
>
  <section class="mx-auto max-w-lg px-4 py-12 flex flex-col gap-10">
    <h1 class="text-xl font-medium text-ink">share sheet preview</h1>

    <div class="flex flex-col gap-2">
      <h2 class="text-lg font-medium text-ink">a game: {gameName('pulse')}</h2>
      <div class="rounded-2xl border border-line p-6">
        <ShareSheet tool="pulse" siteUrl={site.url} client:only="react" />
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <h2 class="text-lg font-medium text-ink">study skills</h2>
      <div class="rounded-2xl border border-line p-6">
        <ShareSheet tool="study" siteUrl={site.url} client:only="react" />
      </div>
    </div>
  </section>
</Layout>
