---
/** Preview-only interface examples, not a lesson or a public course. */
import EmptyState from '../../components/EmptyState.astro';
import Skeleton from '../../islands/Skeleton';
import { ErrorBoundaryDemo } from '../../islands/ErrorBoundary';
import NetworkNotice from '../../components/NetworkNotice.astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="preview: loading and empty states"
  description="Internal preview of cueory's loading and empty state components."
  variant="study"
  noindex
  promo={false}
>
  <div data-state-preview class="mx-auto max-w-page space-y-12 py-12">
    <header class="mx-auto max-w-prose text-center">
      <p class="text-sm text-ink-soft">internal preview · not linked from the site</p>
      <h1 class="mt-2 text-2xl font-semibold text-ink">loading and empty states</h1>
      <p class="mt-3 text-sm text-ink-soft">
        sample interface states only. these are not study materials.
      </p>
    </header>

    <section aria-labelledby="loading-heading" class="space-y-5">
      <h2 id="loading-heading" class="text-xl font-semibold text-ink">while something loads</h2>
      <p class="text-sm text-ink-soft">each group has one accessible loading message. the shapes themselves are decorative.</p>
      <div class="grid gap-5 md:grid-cols-3">
        <div class="rounded-lg border border-line bg-page p-5 shadow-card">
          <h3 class="mb-5 text-base font-semibold text-ink">short lines</h3>
          <Skeleton kind="lines" lines={4} />
        </div>
        <div class="rounded-lg border border-line bg-page p-5 shadow-card">
          <h3 class="mb-5 text-base font-semibold text-ink">a card</h3>
          <Skeleton kind="card" />
        </div>
        <div class="rounded-lg border border-line bg-page p-5 shadow-card">
          <h3 class="mb-5 text-base font-semibold text-ink">progress</h3>
          <Skeleton kind="ring" />
        </div>
      </div>
    </section>

    <section aria-labelledby="empty-heading" class="space-y-5">
      <h2 id="empty-heading" class="text-xl font-semibold text-ink">when there's nothing to show</h2>
      <p class="text-sm text-ink-soft">a clear message, a short explanation, and an action only when it helps.</p>
      <div class="grid items-start gap-5 md:grid-cols-2">
        <EmptyState
          title="nothing found."
          description="try another search or browse the available lessons."
          icon="search"
          actionLabel="browse lessons"
          actionHref="/learn/study-skills"
          headingLevel={3}
        />
        <EmptyState
          title="you're caught up."
          description="there is nothing to review right now."
          icon="check"
          headingLevel={3}
        />
        <EmptyState
          title="no saved cards yet."
          description="open a lesson to find cards worth keeping."
          icon="book"
          actionLabel="open a lesson"
          actionHref="/learn/study-skills"
          headingLevel={3}
        />
        <EmptyState
          title="nothing here yet."
          description="new items will appear here when they're ready."
          headingLevel={3}
        />
        <div data-puzzle-feed-state="none-today">
          <EmptyState
            title="today's puzzle isn't ready."
            description="there isn't a puzzle for today yet. try again later."
            retryLabel="try again"
            headingLevel={3}
          />
        </div>
        <div data-puzzle-feed-state="failed">
          <EmptyState
            title="today's puzzle isn't ready."
            description="we couldn't load today's puzzle. try again later."
            retryLabel="try again"
            headingLevel={3}
          />
        </div>
      </div>
    </section>

    <section aria-labelledby="error-heading" class="space-y-5" data-error-preview>
      <h2 id="error-heading" class="text-xl font-semibold text-ink">when an interactive part fails</h2>
      <p class="text-sm text-ink-soft">choose the sample button to simulate a failed part. the rest of the page stays usable.</p>
      <ErrorBoundaryDemo client:only="react" />
    </section>

    <section aria-labelledby="network-heading" class="space-y-5" data-network-preview>
      <h2 id="network-heading" class="text-xl font-semibold text-ink">when the connection drops</h2>
      <p class="text-sm text-ink-soft">a preview of the offline notice. it appears after the connection stays offline.</p>
      <NetworkNotice />
    </section>
  </div>
</Layout>
