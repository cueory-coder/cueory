---
import Layout from '../layouts/Layout.astro';
---

<Layout title="about us" description="About cueory and our mission.">
  <div class="mx-auto max-w-3xl space-y-10 py-8">
    <div class="space-y-2">
      <h1 class="text-2xl text-ink">about cueory</h1>
    </div>

    <section class="space-y-3" aria-labelledby="mission-heading">
      <h2 id="mission-heading" class="text-xl text-ink">our mission</h2>
      <p class="text-sm text-ink-soft" data-placeholder="CHRISTIAN-TEXT">
        [Christian writes this]
      </p>
    </section>

    <section class="space-y-3" aria-labelledby="who-heading">
      <h2 id="who-heading" class="text-xl text-ink">who we are</h2>
      <p class="text-sm text-ink-soft" data-placeholder="CHRISTIAN-TEXT">
        [Christian writes this]
      </p>
    </section>

    <section class="space-y-3" aria-labelledby="content-heading">
      <h2 id="content-heading" class="text-xl text-ink">how content is made</h2>
      <p class="text-sm text-ink-soft" data-placeholder="CHRISTIAN-TEXT">
        [Christian writes this]
      </p>
    </section>

    <section class="space-y-3" aria-labelledby="support-heading">
      <h2 id="support-heading" class="text-xl text-ink">support us</h2>
      <p class="text-sm text-ink-soft" data-placeholder="CHRISTIAN-TEXT">
        [Christian writes this]
      </p>
      <div class="mt-4">
        <a href="/support" class="inline-flex min-h-11 items-center underline text-sm text-ink">
          visit our support page
        </a>
      </div>
    </section>
  </div>
</Layout>
