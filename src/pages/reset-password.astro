---
import Layout from '../layouts/Layout.astro';
import ResetPassword from '../islands/ResetPassword';
---

<Layout title="reset your password" description="Choose a new password for your cueory account." variant="study" noindex promo={false}>
  <section class="mx-auto max-w-110 py-section font-body leading-relaxed" aria-labelledby="reset-heading">
    <div class="rounded-lg border border-line bg-page p-6 sm:p-8">
      <h1 id="reset-heading" class="text-xl leading-relaxed">choose a new password</h1>
      <div class="mt-6"><ResetPassword client:load /></div>
      <noscript><p class="mt-4">resetting your password needs javascript.</p></noscript>
    </div>
  </section>
</Layout>
