---
import Layout from '../layouts/Layout.astro';
import Wordmark from '../components/Wordmark.astro';
import SignIn from '../islands/SignIn';
---

<Layout title="create an account" description="Create your free cueory account." variant="study" noindex promo={false}>
  <section class="mx-auto max-w-110 py-section font-body leading-relaxed" aria-labelledby="signup-heading">
    <div class="rounded-lg border border-line bg-page p-6 sm:p-8">
      <SignIn mode="signup" client:load>
        <div class="mb-6 text-center">
          <div class="mx-auto mb-4 flex h-20 w-20 items-center justify-center rounded-pill bg-surface">
            <Wordmark variant="emblem" class="w-10" sizes="2.5rem" />
          </div>
          <h1 id="signup-heading" class="font-display text-accent-lg leading-relaxed">
            welcome to
            <Wordmark label="cueory" class="mx-auto mt-2 block w-50 max-w-full" sizes="12.5rem" />
          </h1>
          <p class="mt-4 text-ink-soft">free study tools made by nursing students, for nursing students.</p>
        </div>
      </SignIn>
      <noscript><p class="mt-4">creating an account needs javascript. you can still browse the study materials.</p></noscript>
    </div>
  </section>
</Layout>
