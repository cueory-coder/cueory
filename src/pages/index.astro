---
import Layout from '../layouts/Layout.astro';
import DailyGamesSection from '../components/DailyGamesSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ModesCarousel from '../components/ModesCarousel.astro';
import SignupForm from '../components/SignupForm.astro';
import Wordmark from '../components/Wordmark.astro';
import ContinueBar from '../islands/ContinueBar';
import { accountHref, site } from '../config/site';
---

<Layout title={site.name} variant="home">
  <!--
    The continue strip (Task 104) renders nothing for a first-time visitor. On home the corner buttons float over the
    top of the page (Layout.astro), so when the strip does show, this slot first leaves room for them; otherwise the
    floating header would sit on the strip and swallow its taps.
  -->
  <div class="continue-slot">
    <ContinueBar client:only="react" />
  </div>

  <!--
    Full-screen hero (D-41, D-46, D-55): the logo, a serif headline on one line, the accent line and one glassy button,
    on draped silk, the first of the page's silk scenes (D-53). Lowercase brand voice (D-47).
    Nothing sits behind the headline: the brand guide forbids embossing the logo (§3.6), and the motto lives in the
    footer.
  -->
  <section
    class="scene scene-hero flex min-h-svh items-center justify-center overflow-hidden px-gutter py-section text-center"
    aria-labelledby="hero-heading"
  >
    <!-- A size container: the headline's size follows this box's width, so it stays on one line on every screen. -->
    <div class="@container flex w-full flex-col items-center">
      <Wordmark class="w-(--logo-hero)" sizes="20rem" />
      <h1 id="hero-heading" class="display mt-section text-display-fit">nursing school is hard enough.</h1>
      <p class="mt-4 text-accent text-ink-soft sm:text-accent-lg">cueory makes studying simpler.</p>
      <a href={accountHref} class="glass-button mt-10">create your free account</a>
    </div>
  </section>

  <!--
    Below the hero the silk scenes alternate Ivory and Linen (D-53), and daily games stays right after "ways to study"
    (D-61): how it works (Ivory), ways to study (Linen), daily games (Ivory), features (Linen), launch updates (Ivory).
  -->
  <HowItWorks />

  <ModesCarousel />

  <DailyGamesSection />

  <FeatureGrid />

  <SignupForm />
</Layout>

<script>
  import { revealSections } from '../scripts/reveal';

  revealSections();
</script>

<style>
  /* The corner row's height: two 1rem paddings (py-4) around the 44 px buttons. */
  .continue-slot:has(aside) {
    padding-top: calc(var(--tap-min) + var(--spacing) * 8);
  }
</style>
