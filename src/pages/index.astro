---
import Layout from '../layouts/Layout.astro';
import ModesCarousel from '../components/ModesCarousel.astro';
import SignupForm from '../components/SignupForm.astro';
import Wordmark from '../components/Wordmark.astro';
import { accountHref, site } from '../config/site';
---

<Layout title={site.name} variant="home">
  <!--
    Full-screen hero (D-41, D-46, D-55): the logo, a serif headline on one line, the accent line, one glassy button and
    one short line under it, on draped silk, the first of the page's silk scenes (D-53). Lowercase brand voice (D-47).
    Nothing sits behind the headline: the brand guide forbids embossing the logo (§3.6), and the motto lives in the
    footer.
  -->
  <section
    class="scene scene-hero flex min-h-svh items-center justify-center overflow-hidden px-gutter py-section text-center"
    aria-labelledby="hero-heading"
  >
    <!-- A size container: the headline's size follows this box's width, so it stays on one line on every screen. -->
    <div class="@container flex w-full flex-col items-center">
      <Wordmark class="w-(--logo-hero)" sizes="20rem" />
      <h1 id="hero-heading" class="display mt-section text-display-fit">nursing school is hard enough.</h1>
      <p class="display mt-4 text-accent italic sm:text-accent-lg">cueory makes studying simpler.</p>
      <a href={accountHref} class="glass-button mt-10">create your free account</a>
      <p class="mt-3 text-sm text-ink-soft">save your progress and pick up where you left off.</p>
    </div>
  </section>

  <ModesCarousel />

  <SignupForm />
</Layout>
