---
import Layout from '../layouts/Layout.astro';
import ModesCarousel from '../components/ModesCarousel.astro';
import SignupForm from '../components/SignupForm.astro';
import Wordmark from '../components/Wordmark.astro';
import { accountHref, site } from '../config/site';
---

<Layout title={site.name} variant="home">
  <!--
    Full-screen hero (D-41, D-46): the logo, a serif headline on one line, the accent line, and one glassy button, on
    draped silk. Lowercase brand voice (D-47).
  -->
  <section
    class="silk relative isolate flex min-h-svh items-center justify-center overflow-hidden px-gutter py-section text-center"
    aria-labelledby="hero-heading"
  >
    <!-- The logo pressed faintly into the cloth. Decorative: Wordmark is hidden from screen readers. -->
    <div class="pointer-events-none absolute inset-x-0 top-1/2 -z-10 flex -translate-y-1/2 justify-center">
      <Wordmark class="emboss w-(--logo-emboss) max-w-none shrink-0" />
    </div>

    <!-- A size container: the headline's size follows this box's width, so it stays on one line on every screen. -->
    <div class="@container flex w-full flex-col items-center">
      <Wordmark class="w-(--logo-hero)" />
      <p class="mt-4 text-sm font-medium tracking-label text-ink-soft">{site.tagline}</p>
      <h1 id="hero-heading" class="display mt-section text-display-fit">nursing school is hard enough.</h1>
      <p class="display mt-4 text-accent italic sm:text-accent-lg">cueory makes studying simpler.</p>
      <a href={accountHref} class="glass-button mt-10">create your free account</a>
      <p class="mt-3 text-sm text-ink-soft">save your progress and pick up where you left off.</p>
      <p class="mt-stack text-sm">
        <a href="/learn/study-skills" class="text-ink-soft hover:text-ink">or start the free study-skills course</a>
      </p>
    </div>
  </section>

  <div class="mx-auto w-full max-w-page px-gutter">
    <ModesCarousel />

    <div class="mt-section">
      <SignupForm />
    </div>
  </div>
</Layout>
