---
import Layout from '../../layouts/Layout.astro';
import GameShareLanding from '../../components/GameShareLanding.astro';
import { dailyGames } from '../../config/games';
const game = dailyGames.find((game) => game.id === 'triage')!;
---
<Layout title={game.name} description={game.line} socialImage="/share/games-scene.png" promo={false}>
  <GameShareLanding name={game.name} line={game.line} playHref="/play#sudoku-heading" />
</Layout>
