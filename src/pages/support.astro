---
import Layout from '../layouts/Layout.astro';
import Prose from '../components/Prose.astro';
import { site } from '../config/site';

// Christian's mission, in his words (D-94), lowercase per the brand voice (D-41).
const missionLines = [
  'to make studying for nursing school simpler.',
  'to give nursing students the materials they need to succeed and become great nurses at an affordable price.',
] as const;
---

<Layout
  title="supporting our mission"
  description="cueory is free for every nursing student. supporting our mission keeps it that way."
>
  <Prose>
    <h1>supporting our mission</h1>
    <p>{site.wordmarkName} is free for every nursing student. your support helps our mission:</p>
    <ul data-mission>
      {missionLines.map((line) => <li>{line}</li>)}
    </ul>
    {
      site.tipPageUrl ? (
        <p>
          <a
            href={site.tipPageUrl}
            rel="noopener noreferrer"
            target="_blank"
            class="inline-block rounded-pill bg-button px-6 py-3 text-on-button no-underline hover:bg-button-hover hover:text-on-button"
          >
            support our mission (opens in a new tab)
          </a>
        </p>
      ) : (
        <p class="text-ink-soft">the supporting-our-mission page is coming soon.</p>
      )
    }
    <p>telling a classmate about {site.wordmarkName} helps just as much.</p>
  </Prose>
</Layout>
