---
/**
 * Public course catalog: only unit and topic titles from the reviewed curriculum outline.
 * This page is generated at build time. It never exposes the CSV's planning notes or statuses,
 * and no draft med-surg lesson is linked as if it were published.
 */
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Layout from '../../layouts/Layout.astro';
import UnitCard from '../../components/UnitCard.astro';
import { parseLessonMap } from '../../islands/lessonmap';

const csvText = readFileSync(resolve('docs/curriculum/medsurg-lesson-map.csv'), 'utf8');
const { units, problems } = parseLessonMap(csvText);
if (problems.length) {
  throw new Error('the curriculum map cannot be published: ' + problems.map((problem) =>
    'row ' + problem.row + ': ' + problem.message).join('; '));
}
const lessonCount = units.reduce((sum, unit) =>
  sum + unit.topics.reduce((count, topic) => count + topic.lessons.length, 0), 0);
---

<Layout
  title="learn"
  description="start with a free study-skills lesson, and explore the nursing topics cueory plans to add."
  variant="study"
>
  <div class="mx-auto max-w-page pb-section pt-8 sm:pt-12">
    <header class="mx-auto max-w-prose">
      <p class="text-sm font-medium text-ink-soft">cueory courses</p>
      <h1 class="mt-3 text-2xl">learn</h1>
      <p class="mt-3 text-ink-soft">
        one free study-skills lesson is ready. explore the planned nursing course outline below.
        topics marked coming soon are not available lessons.
      </p>
    </header>

    <section class="mt-section" aria-labelledby="start-here-title">
      <h2 id="start-here-title" class="text-xl">start here</h2>
      <a href="/learn/study-skills"
        class="featured-lesson lift mt-5 block rounded-xl border border-line bg-surface p-6 sm:p-8"
      >
        <span class="text-sm font-medium text-ink-soft">available now · free</span>
        <h3 class="mt-3 text-xl">how to study for nursing school</h3>
        <p class="mt-3 max-w-prose text-ink-soft">
          start with a short lesson, then try the study modes already on the site.
        </p>
        <span class="mt-5 inline-block font-medium underline underline-offset-4">start the lesson</span>
      </a>
    </section>

    <section class="mt-section" aria-labelledby="course-roadmap-title">
      <h2 id="course-roadmap-title" class="text-xl">course roadmap</h2>
      <p class="mt-3 text-ink-soft" data-testid="curriculum-summary">
        {units.length} planned units · {lessonCount} lessons in the outline. these are not yet available to study.
      </p>
      <ol class="mt-7 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3" data-testid="unit-grid" aria-label="planned nursing units">
        {units.map((unit, index) => (
          <li class="min-w-0">
            <UnitCard unit={unit} position={index + 1} />
          </li>
        ))}
      </ol>
    </section>
  </div>
</Layout>

<style>
  .featured-lesson {
    box-shadow: var(--shadow-card, var(--shadow-soft));
  }

  .featured-lesson:hover,
  .featured-lesson:focus-visible {
    box-shadow: var(--shadow-card-hover, var(--shadow-soft));
  }
</style>
