---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import InfoTip from '../../../components/InfoTip.astro';
import OrganizerBoard from '../../../islands/OrganizerBoard';
import { parseSet } from '../../../islands/organizer';

const entry = await getEntry('organizer', 'study-skills-01');
if (!entry) {
  throw new Error('Organizer file content/organizer/study-skills-01.json is missing.');
}
// The same checks the board runs, so a broken file stops the build instead of reaching a student.
const set = parseSet({ id: entry.id, title: entry.data.title, groups: entry.data.groups, items: entry.data.items });
---

<Layout title="organizer: lesson 1" description="sort ideas into groups for lesson 1 of how to study for nursing school." variant="study">
  <div class="mx-auto max-w-prose pt-8">
    <p class="text-sm text-ink-soft">how to study for nursing school · lesson 1</p>
    <div class="mt-2 flex flex-wrap items-center gap-x-1">
      <h1 class="text-2xl">organizer</h1>
      <InfoTip
        id="lesson-intro-info"
        label="organizer"
        text="sort each item into the group it belongs to. nothing is marked until you press check."
      />
    </div>
    {
      entry.data.status === 'sample' && (
        <p class="mt-3 text-sm text-ink-soft" data-testid="organizer-sample-note">
          this is a sample with everyday words. the lesson's own sets come later.
        </p>
      )
    }

    <div class="mt-10">
      {/* client:only: nothing is pre-rendered, so without JavaScript only the note below shows. */}
      <OrganizerBoard client:only="react" set={set} />
      <noscript>
        <p>the organizer needs JavaScript. you can still read the lesson on the <a href="/learn/study-skills">lesson page</a>.</p>
      </noscript>
    </div>

    <p class="mt-section text-sm">
      <a href="/learn/study-skills">back to the lesson</a>
    </p>
  </div>
</Layout>
