---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SentenceStepper from '../../../islands/SentenceStepper';
import LessonVideo from '../../../islands/LessonVideo';
import LessonVisuals from '../../../components/LessonVisuals.astro';
import { isShowable } from '../../../videos/schema';

const lesson = await getEntry('lessons', 'study-skills-01');
if (!lesson) {
  throw new Error('Lesson file content/lessons/study-skills-01.json is missing.');
}
const { title, summary, sentences, status } = lesson.data;
const video = await getEntry('videos', 'study-skills-01');
---

<Layout title={title} description={summary} variant="study">
  <div class="mx-auto max-w-prose pt-8">
    <p class="text-sm text-ink-soft">How to study for nursing school · Lesson 1 of 5</p>
    <h1 class="mt-3 text-2xl">{title}</h1>
    {status === 'placeholder' && <p class="mt-3 text-sm text-ink-soft">This lesson is a placeholder.</p>}

    <div class="mt-10">
      {/* client:only: nothing is pre-rendered, so without JavaScript only the full list below shows. */}
      <SentenceStepper client:only="react" sentences={sentences} />
      <noscript>
        <ol class="space-y-stack">
          {sentences.map((s) => <li class="text-lg">{s.text}</li>)}
        </ol>
      </noscript>
    </div>

    {video && isShowable(video.data.status) && (
      <div class="mt-section">
        <LessonVideo
          client:only="react"
          videoId={video.data.videoId}
          title={video.data.title}
          thumbnail={video.data.thumbnail}
          captionsUrl={video.data.captionsUrl || undefined}
          transcriptUrl={video.data.transcriptUrl || undefined}
        />
      </div>
    )}

    <LessonVisuals lessonId="study-skills-01" />

    <ul class="mt-section space-y-2 text-sm">
      <li><a href="/learn/study-skills/cards">Practice this lesson with cards</a></li>
      <li><a href="/learn/study-skills/learn-mode">Learn this lesson's cards in Learn mode</a></li>
      <li><a href="/learn/study-skills/matching">Match this lesson's terms and meanings</a></li>
    </ul>
  </div>
</Layout>
