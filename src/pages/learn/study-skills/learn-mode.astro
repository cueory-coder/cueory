---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ContentLabel from '../../../components/ContentLabel.astro';
import InfoTip from '../../../components/InfoTip.astro';
import LearnSession from '../../../islands/LearnSession';

const deck = await getEntry('cards', 'study-skills-01');
if (!deck) {
  throw new Error('Card file content/cards/study-skills-01.json is missing.');
}
const { title, cards, status } = deck.data;
const learnCards = cards.map(({ front, back, blank }) => (blank ? { front, back, blank } : { front, back }));
---

<Layout title={`learn mode: ${title}`} description="learn mode for lesson 1 of How to study for nursing school." variant="study">
  <div class="mx-auto max-w-prose pt-8">
    <p class="text-sm text-ink-soft">How to study for nursing school · lesson 1</p>
    <div class="mt-2 flex flex-wrap items-center gap-x-1">
      <h1 class="text-2xl">learn mode</h1>
      <InfoTip
        id="lesson-intro-info"
        label="learn mode"
        text="see each card, choose its answer, then type it. anything you miss comes back until you know every card."
      />
    </div>
    {status === 'placeholder' && <p class="mt-3 text-sm text-ink-soft">these cards are placeholders.</p>}

    <div class="mt-10">
      {/* client:only: nothing is pre-rendered, so without JavaScript only the note below shows. */}
      <LearnSession client:only="react" cards={learnCards} />
      <noscript>
        <p>learn mode needs JavaScript. you can read every card and its answer on the <a href="/learn/study-skills/cards">cards page</a>.</p>
      </noscript>
    </div>

    <p class="mt-section text-sm">
      <a href="/learn/study-skills">back to the lesson</a>
    </p>
    <div class="mt-8">
      <ContentLabel />
    </div>
  </div>
</Layout>
