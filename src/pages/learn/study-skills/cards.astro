---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ContentLabel from '../../../components/ContentLabel.astro';
import CardDeck from '../../../islands/CardDeck';

const deck = await getEntry('cards', 'study-skills-01');
if (!deck) {
  throw new Error('Card file content/cards/study-skills-01.json is missing.');
}
const { title, cards, status } = deck.data;
---

<Layout title={title} description="cards for lesson 1 of How to study for nursing school." variant="study">
  <div class="mx-auto max-w-prose pt-8">
    <p class="text-sm text-ink-soft">How to study for nursing school · lesson 1 cards</p>
    <h1 class="mt-3 text-2xl">{title}</h1>
    {status === 'placeholder' && <p class="mt-3 text-sm text-ink-soft">these cards are placeholders.</p>}

    <div class="mt-10">
      {/* client:only: nothing is pre-rendered, so without JavaScript only the full list below shows. */}
      <CardDeck client:only="react" deckId={deck.id} cards={cards} />
      <noscript>
        <dl class="space-y-stack">
          {
            cards.map((c) => (
              <div>
                <dt class="text-lg">{c.front}</dt>
                <dd class="mt-1 text-ink-soft">{c.back}</dd>
              </div>
            ))
          }
        </dl>
      </noscript>
    </div>

    <ul class="mt-section space-y-2 text-sm">
      <li><a href="/learn/study-skills/learn-mode">learn these cards in learn mode</a></li>
      <li><a href="/learn/study-skills">back to the lesson</a></li>
    </ul>
    <div class="mt-8">
      <ContentLabel />
    </div>
  </div>
</Layout>
