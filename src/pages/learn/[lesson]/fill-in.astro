---
/** A lesson's fill-in set (Task 300: built for every lesson whose set may show; src/lessons/catalog.ts). */
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import InfoTip from '../../../components/InfoTip.astro';
import FillInBoard from '../../../islands/FillInBoard';
import { parseItems } from '../../../islands/fillin';
import { pathsFor, type CatalogLesson } from '../../../lessons/catalog';
import { lessonCatalog } from '../../../lessons/load';

export async function getStaticPaths() {
  return pathsFor(await lessonCatalog(), 'fill-in');
}

const { lesson } = Astro.props as { lesson: CatalogLesson };
const entry = lesson.fillIn && await getEntry('fill-in', lesson.fillIn.id);
if (!entry) throw new Error(`The fill-in file for lesson ${lesson.id} is missing.`);
// The same checks the board runs, so a broken file stops the build instead of reaching a student.
const items = parseItems(entry.data.items);
const page = `${lesson.href}/fill-in`;
---

<Layout title={`fill-in: ${lesson.short}`} description={`recall the missing word for ${lesson.about}.`} variant="study">
  <div class="mx-auto max-w-prose pt-8">
    <p class="text-sm text-ink-soft">{lesson.context} · fill-in</p>
    <div class="mt-2 flex flex-wrap items-center gap-x-1">
      <h1 class="text-2xl">fill-in</h1>
      <InfoTip id="lesson-intro-info" label="fill-in" text="read each sentence and type the missing word. a hint shows its first letter." />
    </div>
    {
      lesson.fillIn!.labeled && (
        <p class="mt-3 text-sm text-ink-soft" data-testid="fill-in-sample-note">
          this is a sample with everyday sentences. the lesson's own sentences come later.
        </p>
      )
    }

    <div class="mt-10" data-testid="fill-in">
      {/* client:only: nothing is pre-rendered, so without JavaScript only the note below shows. */}
      <FillInBoard client:only="react" items={items} page={page} />
      <noscript>
        <p>fill-in needs JavaScript. you can still read the lesson on the <a href={lesson.href}>lesson page</a>.</p>
      </noscript>
    </div>

    <p class="mt-section text-sm">
      <a href={lesson.href}>back to the lesson</a>
    </p>
  </div>
</Layout>
