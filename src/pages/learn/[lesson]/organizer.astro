---
/** A lesson's organizer set (Task 300: built for every lesson whose set may show; src/lessons/catalog.ts). */
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import OrganizerBoard from '../../../islands/OrganizerBoard';
import { parseSet } from '../../../islands/organizer';
import { pathsFor, type CatalogLesson } from '../../../lessons/catalog';
import { lessonCatalog } from '../../../lessons/load';

export async function getStaticPaths() {
  return pathsFor(await lessonCatalog(), 'organizer');
}

const { lesson } = Astro.props as { lesson: CatalogLesson };
const entry = lesson.organizer && await getEntry('organizer', lesson.organizer.id);
if (!entry) throw new Error(`The organizer file for lesson ${lesson.id} is missing.`);
// The same checks the board runs, so a broken file stops the build instead of reaching a student.
const set = parseSet({ id: entry.id, title: entry.data.title, groups: entry.data.groups, items: entry.data.items });
const page = `${lesson.href}/organizer`;
---

<Layout title={`organizer: ${lesson.short}`} description={`sort ideas into groups for ${lesson.about}.`} variant="study">
  <div class="mx-auto max-w-prose pt-8">
    <p class="text-sm text-ink-soft">{lesson.context} · organizer</p>
    <h1 class="mt-3 text-2xl">organizer</h1>
    <p class="mt-3 text-ink-soft">sort each item into the group it belongs to. nothing is marked until you press check.</p>
    {
      lesson.organizer!.labeled && (
        <p class="mt-3 text-sm text-ink-soft" data-testid="organizer-sample-note">
          this is a sample with everyday words. the lesson's own sets come later.
        </p>
      )
    }

    <div class="mt-10">
      {/* client:only: nothing is pre-rendered, so without JavaScript only the note below shows. */}
      <OrganizerBoard client:only="react" set={set} page={page} />
      <noscript>
        <p>the organizer needs JavaScript. you can still read the lesson on the <a href={lesson.href}>lesson page</a>.</p>
      </noscript>
    </div>

    <p class="mt-section text-sm">
      <a href={lesson.href}>back to the lesson</a>
    </p>
  </div>
</Layout>
