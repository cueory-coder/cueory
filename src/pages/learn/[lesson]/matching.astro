---
/** Matching for a lesson's cards (Task 300: built for every lesson whose deck may show; src/lessons/catalog.ts). */
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import MatchingBoard from '../../../islands/MatchingBoard';
import { pathsFor, statusNotice, type CatalogLesson } from '../../../lessons/catalog';
import { lessonCatalog } from '../../../lessons/load';

export async function getStaticPaths() {
  return pathsFor(await lessonCatalog(), 'matching');
}

const { lesson } = Astro.props as { lesson: CatalogLesson };
const deck = lesson.cards && await getEntry('cards', lesson.cards.id);
if (!deck) throw new Error(`The card file for lesson ${lesson.id} is missing.`);
const { title, cards, status } = deck.data;
const cardsNotice = statusNotice(status, 'cards');
const pairs = cards.map(({ front, back }) => ({ front, back }));
const page = `${lesson.href}/matching`;
---

<Layout title={`matching: ${title}`} description={`matching for ${lesson.about}.`} variant="study">
  <div class="mx-auto max-w-prose pt-8">
    <p class="text-sm text-ink-soft">{lesson.context} · matching</p>
    <h1 class="mt-3 text-2xl">matching</h1>
    <p class="mt-3 text-ink-soft">pair each term with what it means.</p>
    {cardsNotice && <p class="mt-3 text-sm text-ink-soft">{cardsNotice}</p>}

    <div class="mt-10">
      {/* client:only: nothing is pre-rendered, so without JavaScript only the note below shows. */}
      <MatchingBoard client:only="react" cards={pairs} page={page} />
      <noscript>
        <p>matching needs JavaScript. you can read every card and its answer on the <a href={`${lesson.href}/cards`}>cards page</a>.</p>
      </noscript>
    </div>

    <p class="mt-section text-sm">
      <a href={lesson.href}>back to the lesson</a>
    </p>
  </div>
</Layout>
