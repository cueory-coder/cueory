---
/** A lesson's cards (Task 300: built for every lesson whose deck may show; src/lessons/catalog.ts). */
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import CardDeck from '../../../islands/CardDeck';
import { pathsFor, statusNotice, type CatalogLesson } from '../../../lessons/catalog';
import { lessonCatalog } from '../../../lessons/load';

export async function getStaticPaths() {
  return pathsFor(await lessonCatalog(), 'cards');
}

const { lesson } = Astro.props as { lesson: CatalogLesson };
const deck = lesson.cards && await getEntry('cards', lesson.cards.id);
if (!deck) throw new Error(`The card file for lesson ${lesson.id} is missing.`);
const { title, cards, status } = deck.data;
const cardsNotice = statusNotice(status, 'cards');
const page = `${lesson.href}/cards`;
---

<Layout title={title} description={`cards for ${lesson.about}.`} variant="study">
  <div class="mx-auto max-w-prose pt-8">
    <p class="text-sm text-ink-soft">{lesson.context} · cards</p>
    <h1 class="mt-3 text-2xl">{title}</h1>
    {cardsNotice && <p class="mt-3 text-sm text-ink-soft">{cardsNotice}</p>}

    <div class="mt-10">
      {/* client:only: nothing is pre-rendered, so without JavaScript only the full list below shows. */}
      <CardDeck client:only="react" deckId={deck.id} cards={cards} page={page} />
      <noscript>
        <dl class="space-y-stack">
          {
            cards.map((c) => (
              <div>
                <dt class="text-lg">{c.front}</dt>
                <dd class="mt-1 text-ink-soft">{c.back}</dd>
              </div>
            ))
          }
        </dl>
      </noscript>
    </div>

    <ul class="mt-section space-y-2 text-sm">
      <li><a href={`${lesson.href}/learn-mode`}>learn these cards in learn mode</a></li>
      <li><a href={lesson.href}>back to the lesson</a></li>
    </ul>
  </div>
</Layout>
