---
import Layout from '../layouts/Layout.astro';
import { courses, roadmap } from '../config/courses';

const plannedCourses = courses.filter((c) => c.status === 'coming-soon');
---

<Layout title="coming soon" description="Planned courses and features for cueory.">
  <div class="mx-auto max-w-3xl space-y-10 py-8">
    <div class="space-y-2">
      <h1 class="text-2xl text-ink">coming soon</h1>
      <p class="text-sm text-ink-soft">what we are currently building for future releases.</p>
    </div>

    <section class="space-y-4" aria-labelledby="planned-courses-heading">
      <h2 id="planned-courses-heading" class="text-xl text-ink">planned courses</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {plannedCourses.map((course) => (
          <div class="rounded-lg border border-line bg-surface p-5">
            <h3 class="text-lg text-ink">{course.title}</h3>
            <p class="mt-2 text-sm text-ink-soft">{course.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-4" aria-labelledby="roadmap-features-heading">
      <h2 id="roadmap-features-heading" class="text-xl text-ink">study features</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {roadmap.map((item) => (
          <div class="rounded-lg border border-line bg-surface p-5">
            <h3 class="text-lg text-ink">{item.title}</h3>
            <p class="mt-2 text-sm text-ink-soft">{item.description}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
