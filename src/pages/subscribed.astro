---
/** Where Kit sends people after they sign up (set as the form's redirect in Kit). */
import Layout from '../layouts/Layout.astro';
import Prose from '../components/Prose.astro';
---

<Layout title="check your inbox" noindex promo={false}>
  <Prose>
    <h1>almost done: check your inbox</h1>
    <p>we've sent you an email. click the button in it to confirm your signup.</p>
    <p>if it's not there in a few minutes, check your spam or promotions folder.</p>
    <p><a href="/">back to the home page</a></p>
  </Prose>
</Layout>
