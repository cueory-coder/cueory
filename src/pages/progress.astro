---
import { getCollection } from 'astro:content';
import { lessonCatalog } from '../lessons/load';
import { visibleProgressDecks, visibleProgressLessons } from '../islands/progressview';
import Layout from '../layouts/Layout.astro';
import ProgressPanel from '../islands/ProgressPanel';
import GuestImportOffer from '../islands/GuestImportOffer.tsx';
import BrandMark from '../components/BrandMark.astro';

// Only a visible lesson with a visible cards companion may enter the browser props.
const [catalog, cards] = await Promise.all([lessonCatalog(), getCollection('cards')]);
const decks = visibleProgressDecks(catalog, cards);
// Course lesson counts include visible lessons even when they have no card deck.
const progressProps = { decks, lessons: visibleProgressLessons(catalog) };
---

<Layout
  title="your progress"
  description="What cueory keeps in your browser: your setup answers, card piles and stars. Download it or forget it."
  noindex
  promo={false}
>
  <div class="mx-auto max-w-prose pt-8">
    <h1 class="text-2xl">your progress on this device</h1>
    <p class="mt-3 text-ink-soft">
      your study progress stays in this browser. when it’s readable, review, download or clear it here.
    </p>

    <div class="mt-10">
      {/* Sign-in lands here by default; the offer shows only to a signed-in student with progress to bring in. */}
      <GuestImportOffer client:only="react" />
      {/* client:only: progress lives in this browser, so there is nothing to pre-render. */}
      <ProgressPanel client:only="react" {...progressProps} />
      <noscript>
        <p>this page needs javascript turned on to read what your browser saved.</p>
      </noscript>
      <BrandMark path="/progress" />
    </div>
  </div>
</Layout>
